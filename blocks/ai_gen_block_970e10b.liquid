{% doc %}
  @prompt
    Add a row below this custom liquid row, that takes the details from this page https://www.krisgethin.com/kgservices specifically the 2 row items under Personal Video Call with Kris Gethin and recreate it here. Please make sure that the row you'll generate is tablet and mobile responsive and that every element in it heading, subheading, description, and button are all mobiile responsive., Can you add a place for me to put images in each column item, place whatever image i'll put on there to the left of the block they're supposed to be in, can you make it so that the images i add cover the left side of their respective blocks? maybe a split of 30-70 between image area and text and button area would be good.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-services-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-two-column-services__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.column_gap }}px;
    max-width: {{ block.settings.max_content_width }}px;
    margin: 0 auto;
  }

  .ai-two-column-services__column-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 30% 70%;
    gap: 0;
    background-color: {{ block.settings.column_background_color }};
    border-radius: {{ block.settings.column_border_radius }}px;
    overflow: hidden;
  }

  .ai-two-column-services__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-two-column-services__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-two-column-services__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 300px;
  }

  .ai-two-column-services__image-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-two-column-services__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
    padding: {{ block.settings.column_padding }}px;
  }

  .ai-two-column-services__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-weight: 700;
  }

  .ai-two-column-services__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    line-height: 1.4;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    font-weight: 600;
  }

  .ai-two-column-services__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    color: {{ block.settings.description_color }};
    margin: 0;
  }

  .ai-two-column-services__description-{{ ai_gen_id }} p {
    margin: 0 0 1em;
  }

  .ai-two-column-services__description-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-two-column-services__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    text-align: center;
    transition: background-color 0.3s ease;
    border: none;
    cursor: pointer;
    align-self: flex-start;
  }

  .ai-two-column-services__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-two-column-services-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px {{ block.settings.section_padding_horizontal | times: 0.7 }}px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-two-column-services__container-{{ ai_gen_id }} {
      gap: {{ block.settings.column_gap | times: 0.7 }}px;
    }

    .ai-two-column-services__content-{{ ai_gen_id }} {
      padding: {{ block.settings.column_padding | times: 0.8 }}px;
      gap: {{ block.settings.content_gap | times: 0.8 }}px;
    }

    .ai-two-column-services__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-two-column-services__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }

    .ai-two-column-services__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-two-column-services__button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.9 }}px {{ block.settings.button_padding_horizontal | times: 0.9 }}px;
    }

    .ai-two-column-services__image-placeholder-{{ ai_gen_id }} {
      min-height: 250px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-two-column-services-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.5 }}px {{ block.settings.section_padding_horizontal | times: 0.5 }}px {{ block.settings.section_padding_bottom | times: 0.5 }}px;
    }

    .ai-two-column-services__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.column_gap | times: 0.6 }}px;
    }

    .ai-two-column-services__column-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-two-column-services__image-placeholder-{{ ai_gen_id }} {
      min-height: 200px;
    }

    .ai-two-column-services__content-{{ ai_gen_id }} {
      padding: {{ block.settings.column_padding | times: 0.7 }}px;
      gap: {{ block.settings.content_gap | times: 0.7 }}px;
    }

    .ai-two-column-services__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-two-column-services__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.75 }}px;
    }

    .ai-two-column-services__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.85 }}px;
    }

    .ai-two-column-services__button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.85 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.85 }}px {{ block.settings.button_padding_horizontal | times: 0.85 }}px;
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-two-column-services-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-two-column-services__container-{{ ai_gen_id }}">
    <div class="ai-two-column-services__column-{{ ai_gen_id }}">
      <div class="ai-two-column-services__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.column_1_image %}
          <img
            src="{{ block.settings.column_1_image | image_url: width: 600 }}"
            alt="{{ block.settings.column_1_image.alt | escape }}"
            class="ai-two-column-services__image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.column_1_image.width }}"
            height="{{ block.settings.column_1_image.height }}"
          >
        {% else %}
          <div class="ai-two-column-services__image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-two-column-services__content-{{ ai_gen_id }}">
        {% if block.settings.column_1_heading != blank %}
          <h3 class="ai-two-column-services__heading-{{ ai_gen_id }}">
            {{ block.settings.column_1_heading }}
          </h3>
        {% endif %}

        {% if block.settings.column_1_subheading != blank %}
          <h4 class="ai-two-column-services__subheading-{{ ai_gen_id }}">
            {{ block.settings.column_1_subheading }}
          </h4>
        {% endif %}

        {% if block.settings.column_1_description != blank %}
          <div class="ai-two-column-services__description-{{ ai_gen_id }}">
            {{ block.settings.column_1_description }}
          </div>
        {% endif %}

        {% if block.settings.column_1_button_text != blank %}
          <a 
            href="{{ block.settings.column_1_button_link }}" 
            class="ai-two-column-services__button-{{ ai_gen_id }}"
          >
            {{ block.settings.column_1_button_text }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="ai-two-column-services__column-{{ ai_gen_id }}">
      <div class="ai-two-column-services__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.column_2_image %}
          <img
            src="{{ block.settings.column_2_image | image_url: width: 600 }}"
            alt="{{ block.settings.column_2_image.alt | escape }}"
            class="ai-two-column-services__image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.column_2_image.width }}"
            height="{{ block.settings.column_2_image.height }}"
          >
        {% else %}
          <div class="ai-two-column-services__image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-two-column-services__content-{{ ai_gen_id }}">
        {% if block.settings.column_2_heading != blank %}
          <h3 class="ai-two-column-services__heading-{{ ai_gen_id }}">
            {{ block.settings.column_2_heading }}
          </h3>
        {% endif %}

        {% if block.settings.column_2_subheading != blank %}
          <h4 class="ai-two-column-services__subheading-{{ ai_gen_id }}">
            {{ block.settings.column_2_subheading }}
          </h4>
        {% endif %}

        {% if block.settings.column_2_description != blank %}
          <div class="ai-two-column-services__description-{{ ai_gen_id }}">
            {{ block.settings.column_2_description }}
          </div>
        {% endif %}

        {% if block.settings.column_2_button_text != blank %}
          <a 
            href="{{ block.settings.column_2_button_link }}" 
            class="ai-two-column-services__button-{{ ai_gen_id }}"
          >
            {{ block.settings.column_2_button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

