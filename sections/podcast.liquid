{{ 'podcast.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Podcast caption */
  #podcast .section-{{ section.id }}-padding .caption {
    font-size: 32px !important;
    line-height: 1.2 !important;
  }

  /* Podcast heading */
  #podcast .section-{{ section.id }}-padding .title {
    font-size: 82px !important;
    line-height: 1.1 !important;
  }

  /* Podcast subtitle */
  #podcast .section-{{ section.id }}-padding .subtitle,
  #podcast .section-{{ section.id }}-padding .subtitle p {
    font-size: 30px !important;
    line-height: 1.35 !important;
  }

  /* Podcast description */
  #podcast .section-{{ section.id }}-padding .description,
  #podcast .section-{{ section.id }}-padding .description p {
    font-size: 20px !important;
    line-height: 26px !important;
  }

  @media screen and (max-width: 749px) {
    #podcast .section-{{ section.id }}-padding .caption {
      font-size: 14px !important;
      line-height: 18.2px !important;
    }

    #podcast .section-{{ section.id }}-padding .title {
      font-size: 42px !important;
      line-height: 1.1 !important;
    }

    #podcast .section-{{ section.id }}-padding .subtitle,
    #podcast .section-{{ section.id }}-padding .subtitle p {
      font-size: 18px !important;
      line-height: 1.3 !important;
    }

    #podcast .section-{{ section.id }}-padding .description,
    #podcast .section-{{ section.id }}-padding .description p {
      font-size: 14px !important;
      line-height: 18.2px !important;
    }
  }

  #podcast .podcast-inner .title-wrapper .caption {
    margin-top: 0 !important;
    margin-bottom: 0px !important;
  }

  #podcast .podcast-inner .title-wrapper .title {
    margin-top: 0 !important;
  }

  #podcast .podcast-inner .title-wrapper .title {
    margin-bottom: 0px !important;
  }

{%- endstyle -%}

<div id="podcast" class="podcast-section color-{{ section.settings.color_scheme }} gradient">
  <div class="podcast-wrapper color-{{ section.settings.color_scheme }} gradient">
    <div class="podcast-inner section-{{ section.id }}-padding">
      {%- if section.settings.caption != blank or section.settings.title != blank or section.settings.subtitle != blank or section.settings.description != blank -%}
        <div class="title-wrapper page-width title-wrapper--no-top-margin {{ section.settings.heading_alignment }}">
          {% if section.settings.caption != blank %}
            <p class="caption">{{ section.settings.caption }}</p>
          {% endif %}
          {% if section.settings.title != blank %}
            <h2 class="title inline-richtext {{ section.settings.heading_size }}">
              {{ section.settings.title }}
            </h2>
          {% endif %}
          {% if section.settings.subtitle != blank %}
            <div class="subtitle">
              <p>{{ section.settings.subtitle }}</p>
            </div>
          {% endif %}
          {% if section.settings.podcast_link != blank or section.settings.spotify_link != blank or section.settings.youtube_link != blank %}
            <div class="social-media-list">
              {% if section.settings.podcast_link != blank %}
                <a href="{{ section.settings.podcast_link }}" target="_blank">
                  <img src="{{ 'podcasts.png' | asset_url }}" width="" height="" alt="" loading="lazy">
                </a>
              {% endif %}
              {% if section.settings.spotify_link != blank %}
                <a href="{{ section.settings.spotify_link }}" target="_blank">
                  <img src="{{ 'spotify.png' | asset_url }}" width="" height="" alt="" loading="lazy">
                </a>
              {% endif %}
              {% if section.settings.youtube_link != blank %}
                <a href="{{ section.settings.youtube_link }}" target="_blank">
                  <img src="{{ 'youtube.png' | asset_url }}" width="" height="" alt="" loading="lazy">
                </a>
              {% endif %}
            </div>
          {% endif %}
          {% if section.settings.description != blank %}
            <div class="description rte">
              {{ section.settings.description }}
            </div>
          {% endif %}
        </div>
      {%- endif -%}

      <div class="podcast-content">
        <div class="podcast-image-wrapper">
          {% if section.settings.custom_code != blank %}
            {{ section.settings.custom_code }}
          {% else %}
            <div class="podcast-image_media global-media-settings{% if section.settings.image != blank %} media{% else %} image-with-text__media--placeholder placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}"
              style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
            >
              {%- if section.settings.image != blank -%}
                <img src="{{ section.settings.image | image_url }}" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" alt="{{ section.settings.image.alt }}" loading="lazy">
              {%- else -%}
                {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
              {% if section.settings.image_link != blank %}
                <a href="{{ section.settings.image_link }}" target="_blank" class="image-link"></a>
              {% endif %}
            </div>
          {% endif %}
        </div>
        <div class="podcast-content-wrapper">
          <div id="podcast-{{ section.id }}" class="podcast-images swiper swiper-container">
            <div class="podcast-list swiper-wrapper">
              {% for block in section.blocks %}
                <div class="podcast-list-item swiper-slide">
                  {% if block.settings.custom_code != blank %}
                    {{ block.settings.custom_code }}
                  {% else %}
                    <a {% if block.settings.image_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.image_link }}"{% endif %}>
                      <div class="podcast-image">
                        <div class="media media--transparent" style="padding-bottom: {{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;">
                          <img src="{{ block.settings.image | image_url }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" alt="{{ block.settings.image.alt }}" loading="lazy">
                        </div>
                      </div>
                    </a>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
            <div class="swiper-button-wrapper">
              <div class="swiper-button swiper-button-prev">
                <svg width="15" height="8" class="icon icon-arrow" viewBox="0 0 15 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M14.4232 4.33379C14.6329 4.12409 14.6329 3.78411 14.4232 3.57442L11.006 0.157246C10.7963 -0.0524487 10.4563 -0.0524487 10.2466 0.157246C10.0369 0.36694 10.0369 0.706923 10.2466 0.916617L13.2841 3.9541L10.2466 6.99159C10.0369 7.20128 10.0369 7.54126 10.2466 7.75096C10.4563 7.96065 10.7963 7.96065 11.006 7.75096L14.4232 4.33379ZM0 3.9541V4.49106H14.0435V3.9541V3.41715H0V3.9541Z" fill="currentColor"/>
                </svg>
              </div>
              <div class="slider__pagination"></div>
              <div class="swiper-button swiper-button-next">
                <svg width="15" height="8" class="icon icon-arrow" viewBox="0 0 15 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M14.4232 4.33379C14.6329 4.12409 14.6329 3.78411 14.4232 3.57442L11.006 0.157246C10.7963 -0.0524487 10.4563 -0.0524487 10.2466 0.157246C10.0369 0.36694 10.0369 0.706923 10.2466 0.916617L13.2841 3.9541L10.2466 6.99159C10.0369 7.20128 10.0369 7.54126 10.2466 7.75096C10.4563 7.96065 10.7963 7.96065 11.006 7.75096L14.4232 4.33379ZM0 3.9541V4.49106H14.0435V3.9541V3.41715H0V3.9541Z" fill="currentColor"/>
                </svg>
              </div>
            </div>
          </div>
          {%- if section.settings.button_label != blank -%}
            <a {% if section.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.button_link }}"{% endif %} class="button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}" {{ section.shopify_attributes }}>
              <span>{{ section.settings.button_label | escape }}</span>
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript">
  swiper = new Swiper("#podcast-{{ section.id }}", {
    speed: 500,
    slidesPerView: 2,
    slidesPerColumn: 2,
    slidesPerGroup: 1,
    slidesPerColumnFill: 'column',
    spaceBetween: 23,
     navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },
    pagination: {
      el: '.slider__pagination',
      clickable: true,
    },
    breakpoints: {
      0: {
        slidesPerView: 1,
        slidesPerColumn: 1,
        slidesPerGroup: 1,
        slidesPerColumnFill: 'column',
        spaceBetween: 12,
      },
      749: {
        slidesPerView: 1,
        slidesPerColumn: 1,
        slidesPerGroup: 1,
        slidesPerColumnFill: 'column',
        spaceBetween: 23,
      },
      989: {
        slidesPerView: 1,
        slidesPerColumn: 2,
        slidesPerGroup: 1,
        slidesPerColumnFill: 'column',
        spaceBetween: 23,
      },
      1260: {
        slidesPerView: 1,
        slidesPerColumn: 2,
        slidesPerGroup: 1,
        slidesPerColumnFill: 'column',
        spaceBetween: 23,
      },
      1900: {
        slidesPerView: 2,
        slidesPerColumn: 2,
        slidesPerGroup: 1,
        slidesPerColumnFill: 'column',
        spaceBetween: 23,
      }
    }
  });
</script>

{% schema %}
  {
    "name": "Podcast",
    "class": "section main-podcast",
    "tag": "section",
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "url",
        "id": "image_link",
        "label": "Image URL"
      },
      {
        "type": "liquid",
        "id": "custom_code",
        "label": "Embed iframe code"
      },
      {
        "type": "text",
        "id": "caption",
        "label": "Caption",
        "default": "Caption"
      },
      {
        "type": "inline_richtext",
        "id": "title",
        "default": "Podcast",
        "label": "t:sections.multicolumn.settings.title.label"
      },
      {
        "type": "select",
        "id": "heading_size",
        "options": [
          {
            "value": "h2",
            "label": "t:sections.all.heading_size.options__1.label"
          },
          {
            "value": "h1",
            "label": "t:sections.all.heading_size.options__2.label"
          },
          {
            "value": "h0",
            "label": "t:sections.all.heading_size.options__3.label"
          },
          {
            "value": "hxl",
            "label": "t:sections.all.heading_size.options__4.label"
          },
          {
            "value": "hxxl",
            "label": "t:sections.all.heading_size.options__5.label"
          }
        ],
        "default": "h1",
        "label": "t:sections.all.heading_size.label"
      },
      {
        "type": "inline_richtext",
        "id": "subtitle",
        "label": "Subtitle",
        "default": "Subtitle"
      },
      {
        "type": "richtext",
        "id": "description",
        "label": "Description",
        "default": "<p>Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text</p>"
      },
      {
        "type": "text_alignment",
        "id": "heading_alignment",
        "label": "Heading alignment",
        "default": "center"
      },
      {
        "type": "header",
        "content": "Social media links"
      },
      {
        "type": "url",
        "id": "podcast_link",
        "label": "Podcast link"
      },
      {
        "type": "url",
        "id": "spotify_link",
        "label": "Spotify link"
      },
      {
        "type": "url",
        "id": "youtube_link",
        "label": "Youtube link"
      },
      {
        "type": "header",
        "content": "Button content"
      },
      {
        "type": "text",
        "id": "button_label",
        "default": "t:sections.multicolumn.settings.button_label.default",
        "label": "t:sections.multicolumn.settings.button_label.label", 
        "info": "t:sections.multicolumn.settings.button_label.info"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "t:sections.multicolumn.settings.button_link.label"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:sections.all.colors.label",
        "default": "scheme-1"
      },
      {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "blocks": [
      {
        "type": "image",
        "name": "Image",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "url",
            "id": "image_link",
            "label": "Image link"
          },
          {
            "type": "liquid",
            "id": "custom_code",
            "label": "Embed iframe code"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Podcast",
        "blocks": [
          {
            "type": "image"
          },
          {
            "type": "image"
          },
          {
            "type": "image"
          },
          {
            "type": "image"
          }
        ]
      }
    ]
  }
{% endschema %}