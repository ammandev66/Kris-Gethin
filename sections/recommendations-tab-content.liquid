{{ 'recommendations-tab-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  .tab_content-actions {
    margin-top: 8px !important;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {% if section.settings.bg_image != blank %}
    #section-{{ section.id }} .recommendations-tab-content-inner { background: url({{ section.settings.bg_image | image_url }})no-repeat scroll center; background-size: cover; padding-block: 4rem;}
  {% endif %}

  @media screen and (max-width: 749px) {
    .main-recommendations-tab-content .tab_content-info__image-wrapper {
      transform: scale(1.2);
      transform-origin: center;
    }
  }

    /* Tab title font - use site Avenir */
    #section-{{ section.id }} .tab-heading .tab__title,
    #section-{{ section.id }} .tab-heading .tab__title * {
      font-family: Avenir, "Avenir Next", sans-serif !important;
    }

{%- endstyle -%}

<div id="section-{{ section.id }}" class="recommendations-tab-content-wrapper{% if section.settings.custom_class != blank %} {{  section.settings.custom_class }}{% endif %} color-{{ section.settings.color_scheme }} gradient">
  <div class="recommendations-tab-content-inner color-{{ section.settings.color_scheme }} gradient">
    <div class="recommendations-tab-content">
      <div class="page-width section-{{ section.id }}-padding">
        {%- if section.settings.title != blank or section.settings.description != blank -%}
          <div class="title-wrapper title-wrapper--no-top-margin {{ section.settings.heading_alignment }}">
            {% if section.settings.title != blank %}
              <h2 class="title inline-richtext {{ section.settings.heading_size }}">
                {{ section.settings.title }}
              </h2>
            {% endif %}
            {% if section.settings.description != blank %}
              <div class="description rte">
                {{ section.settings.description }}
              </div>
            {% endif %}
          </div>
        {%- endif -%}

        <div class="tab_content_wrapper">
          <div class="tab_content_inner">
            <div class="tab_content1">
              {% assign tabgroup = 0 %}
              {% for block in section.blocks %}
                {% if block.type == 'tab_title' %}
                  {% assign tabgroup = tabgroup | plus:1 %}
                  {% if block.settings.title != blank %}
                    <div class="tab-heading tab_group_{{ tabgroup }}{% if tabgroup == 1 %} active{% endif %}" data-group-content="tab_group_content_{{ tabgroup }}">
                      <h3 class="tab__title inline-richtext h4">{{ block.settings.title }}</h3>
                    </div>
                  {% endif %}
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
        <div class="tab_content">
          {% assign tabgroup = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'tab_title' %}
              {% assign tabgroup = tabgroup | plus: 1 %}
              {% if tabgroup > 1 %}
                </div>
                  
                </div>
              {% endif %}
              <div id="section-{{ section.id }}-{{ tabgroup }}" class="tab_group-wrapper{% if tabgroup == 1 %} active{% endif %} tab_group_content_{{ tabgroup }}">
              <div class="tab_content-list grid grid--1-col-tablet-down grid--2-col-desktop">
            {% endif %}
            {% if block.type == 'tab_content' %}
              <div class="tab_content-list-item grid__item color-{{ section.settings.column_color_scheme }} gradient">
                <div class="tab_content-card">
                  {% if block.settings.image != blank %}
                    <div class="tab_content-card__image-wrapper mobile-image-{{ block.settings.mobile_image_position }}">
                      <div class="media media--transparent" style="padding-bottom: {{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;">
                        <img src="{{ block.settings.image | image_url }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" alt="{{ block.settings.image.alt }}" loading="lazy" fetchpriority="auto" />
                      </div>
                    </div>
                  {% endif %}
                  {% if block.settings.brand_image != blank or block.settings.heading != blank or block.settings.promo != blank %}
                    <div class="tab_content-info">
                      {%- if block.settings.brand_image != blank -%}
                        <div class="tab_content-info__image-wrapper">
                          <div class="media media--transparent" style="padding-bottom: {{ 1 | divided_by: block.settings.brand_image.aspect_ratio | times: 100 }}%;">
                            <img src="{{ block.settings.brand_image | image_url }}" width="{{ block.settings.brand_image.width }}" height="{{ block.settings.brand_image.height }}" alt="{{ block.settings.brand_image.alt }}" loading="lazy" fetchpriority="auto" />
                          </div>
                        </div>
                      {%- endif -%}
                      {% if block.settings.caption != blank %}
                        <p class="tab_content-caption">{{ block.settings.caption }}</p>
                      {% endif %}
                      {%- if block.settings.heading != blank -%}
                        <h3 class="inline-richtext {{ block.settings.heading_size }}">{{- block.settings.heading -}}</h3>
                      {%- endif -%}
                      {% if block.settings.content != blank %}
                        <div class="content rte">
                          {{ block.settings.content }}
                        </div>
                      {% endif %}
                      {%- if block.settings.promo != blank -%}
                        <div class="promo">{{ block.settings.promo }}</div>
                      {%- endif -%}
                    </div>
                  {% endif %}
                </div>
                  {%- if block.settings.button_label != blank -%}
                    <div class="tab_content-actions button-wrapper">
                      <a class="button button--primary"
                        {% if block.settings.button_link == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.button_link }}" target="_blank" rel="noopener noreferrer"
                        {% endif %}>
                        <span>{{ block.settings.button_label | escape }}</span>
                      </a>
                    </div>
                  {%- endif -%}
              </div>
            {% endif %}
            {% if forloop.last %}
              </div>
                
              </div>
            {% endif %}
          {% endfor %}
        </div>

        {%- if section.settings.button_label != blank -%}
          <div class="center button-wrapper">
            <a class="button button--primary" {% if section.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.button_link }}"{% endif %}>
              <span>{{ section.settings.button_label | escape }}</span>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script type="text/javascript">
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.tab-heading').forEach(tab => {
      tab.addEventListener('click', function () {
        const target = this.dataset.groupContent;
        document.querySelectorAll('.tab_group-wrapper').forEach(el => {
          el.classList.remove('active');
        });
        document.querySelector('.' + target).classList.add('active');
      });
    });
  });
</script>

<script type="text/javascript">
  $(".tab_content1 .tab-heading").on('click', function(){  
    var panelgroup = $(this).attr("data-group-content");
    
     $(".tab_content1 .tab-heading").removeClass("active");
     $(".tab_content .tab_group-wrapper").removeClass("active");
    
     $(this).addClass("active");
     $("."+panelgroup).addClass("active");
  });
</script>

