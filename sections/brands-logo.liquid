{{ 'section-brands-logo.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #Slider-{{ section.id }} .brands-logo-list__item {
    display: flex;
    justify-content: center;
  }

  #Slider-{{ section.id }} .brands-logo-card {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 auto !important;
    overflow: visible !important;
  }

  #Slider-{{ section.id }} .brands-logo-card__image-wrapper,
  #Slider-{{ section.id }} .brands-logo-card__image-wrapper .media {
    width: 100% !important;
    max-width: 100% !important;
  }

  .section-{{ section.id }}-padding .brands-logo__title {
    margin-bottom: 2rem !important;
  }
  
  /* Brands Logo - control real spacing between logo items */
  #Slider-{{ section.id }}.brands-logo-list {
    margin-left: 0 !important;
    column-gap: 30px !important;
    row-gap: 30px !important;
    justify-content: center !important;
  }

  #Slider-{{ section.id }} .brands-logo-list__item {
    padding-left: 0 !important;
  }
  
  /* Mobile - remove slider/grid offset and center logo group */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .slider-mobile-gutter {
      margin-left: 0 !important;
      margin-right: 0 !important;
    }

    #Slider-{{ section.id }}.brands-logo-list {
      padding-left: 0 !important;
      padding-right: 0 !important;
      margin-left: auto !important;
      margin-right: auto !important;
      width: 100% !important;
    }

    #Slider-{{ section.id }} .brands-logo-list__item {
      margin-left: auto !important;
      margin-right: auto !important;
    }
  }
  

{%- endstyle -%}

{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif
-%}

<div class="brands-logo-wrapper{% if section.settings.custom_class != blank %} {{  section.settings.custom_class }}{% endif %} color-{{ section.settings.color_scheme }} gradient">
  <div class="brands-logo color-{{ section.settings.color_scheme }} gradient{% unless section.settings.background_style == 'none' and settings.text_boxes_border_thickness > 0 or settings.text_boxes_shadow_opacity > 0 %} background-{{ section.settings.background_style }}{% endunless %}{% if section.settings.title == blank %} no-heading{% endif %}">
    <div
      class="page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      {% if settings.animations_reveal_on_scroll %}
        data-cascade
      {% endif %}
    >
      {%- unless section.settings.title == blank -%}
        <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin brands-logo__title {{ section.settings.heading_alignment }}">
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
          {%- if section.settings.button_label != blank and show_mobile_slider -%}
            <a href="{{ section.settings.button_link }}" class="link underlined-link large-up-hide">
              {{- section.settings.button_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endunless -%}
      <slider-component class="slider-mobile-gutter">
        <ul
          class="brands-logo-list contains-content-container grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop{% if show_mobile_slider %} slider slider--tablet grid--peek{% endif %}"
          id="Slider-{{ section.id }}"
          role="list"
        >
          {%- liquid
            assign highest_ratio = 0
            for block in section.blocks
              if block.settings.image.aspect_ratio > highest_ratio
                assign highest_ratio = block.settings.image.aspect_ratio
              endif
            endfor
          -%}
          {%- for block in section.blocks -%}
            {%- assign empty_column = '' -%}
            {%- if block.settings.image == blank
              and block.settings.title == blank
              and block.settings.text == blank
              and block.settings.link_label == blank
            -%}
              {%- assign empty_column = ' brands-logo-list__item--empty' -%}
            {%- endif -%}
            {% comment %} {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
            {%- assign placeholder_image = 'detailed-apparel-' | append: placeholder_image_index -%} {% endcomment %}
            <li
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              class="brands-logo-list__item grid__item{% if section.settings.swipe_on_mobile %} slider__slide{% endif %}{% if section.settings.column_alignment == 'center' %} center{% endif %}{{ empty_column }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {{ block.shopify_attributes }}
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              <div class="brands-logo-card content-container{% unless section.settings.background_style == 'none' %} color-{{ section.settings.content_colors }} gradient{% endunless %}">
                <div class="brands-logo-card__image-wrapper brands-logo-card__image-wrapper--{{ section.settings.image_width }}-width{% if section.settings.image_width != 'full' or spaced_image %} brands-logo-card-spacing{% endif %}{% if block.settings.image == blank %} brands-logo-card__image-wrapper--placeholder{% endif %}">
                  {%- if block.settings.image != blank -%}
                    <a href="{{ block.settings.link }}">
                      {% if section.settings.image_ratio == 'adapt' or section.settings.image_ratio == 'circle' %}
                        {% assign spaced_image = true %}
                      {% endif %}
                      <div
                        class="media media--transparent media--{{ section.settings.image_ratio }}"
                        {% if section.settings.image_ratio == 'adapt' %}
                          style="padding-bottom: {{ 1 | divided_by: highest_ratio | times: 100 }}%;"
                        {% endif %}
                      >
                        {%- liquid
                          assign number_of_columns = section.settings.columns_desktop
                          assign number_of_columns_mobile = section.settings.columns_mobile
                          assign grid_space_desktop = number_of_columns | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
                          assign grid_space_tablet = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
                          assign grid_space_mobile = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | divided_by: 2 | plus: 30 | append: 'px'
                          if section.settings.image_width == 'half'
                            assign image_width = 0.5
                          elsif section.settings.image_width == 'third'
                            assign image_width = 0.33
                          else
                            assign image_width = 1
                          endif
                        -%}
                        {% capture sizes %}
                          (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - {{ grid_space_desktop }}) * {{ image_width }} /  {{ number_of_columns }}),
                          (min-width: 990px) calc((100vw - {{ grid_space_desktop }}) * {{ image_width }} / {{ number_of_columns }}),
                          (min-width: 750px) calc((100vw - {{ grid_space_tablet }}) * {{ image_width }} / {{ number_of_columns_mobile }}),
                          calc((100vw - {{ grid_space_mobile }}) * {{ image_width }} / {{ number_of_columns_mobile }})
                        {% endcapture %}
                        {{
                          block.settings.image
                          | image_url: width: 3200
                          | image_tag:
                            widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
                            sizes: sizes,
                            class: 'brands-logo-card__image'
                        }}
                      </div>
                    </a>
                  {%- else -%}
                    <div class="media media--transparent placeholder">
                      {{- 'image' | placeholder_svg_tag: 'placeholder-svg' -}}
                    </div>
                  {%- endif -%}
                </div>
                {%- if block.settings.title != blank or block.settings.text != blank or block.settings.link_label != blank -%}
                  <div class="brands-logo-card__info">
                    {%- if block.settings.title != blank -%}
                      <h3 class="inline-richtext">{{ block.settings.title }}</h3>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <div class="rte">{{ block.settings.text }}</div>
                    {%- endif -%}
                    {%- if block.settings.link_label != blank -%}
                      <a
                        class="link animate-arrow"
                        {% if block.settings.link == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.link }}"
                        {% endif %}
                      >
                        {{- block.settings.link_label | escape -}}
                        <span class="svg-wrapper"
                          ><span class="icon-wrap">&nbsp;{{ 'icon-arrow.svg' | inline_asset_content }}</span></span
                        >
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- if show_mobile_slider -%}
          <div class="slider-buttons large-up-hide">
            <button
              type="button"
              class="slider-button slider-button--prev"
              name="previous"
              aria-label="{{ 'general.slider.previous_slide' | t }}"
            >
              <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
            </button>
            <div class="slider-counter caption">
              <span class="slider-counter--current">1</span>
              <span aria-hidden="true"> / </span>
              <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
              <span class="slider-counter--total">{{ section.blocks.size }}</span>
            </div>
            <button
              type="button"
              class="slider-button slider-button--next"
              name="next"
              aria-label="{{ 'general.slider.next_slide' | t }}"
            >
              <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
            </button>
          </div>
        {%- endif -%}
      </slider-component>
      <div class="brands-logo--action center{% if show_mobile_slider %} small-hide medium-hide{% endif %}">
        {%- if section.settings.button_label != blank -%}
          <a
            class="button button--primary"
            {% if section.settings.button_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.button_link }}"
            {% endif %}
          >
            <span>{{ section.settings.button_label | escape }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.brands-logo.name",
  "class": "section section-brands-logo",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.all.custom_class.label",
      "info": "t:sections.all.custom_class.info"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.brands-logo.settings.title.default",
      "label": "t:sections.brands-logo.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text_alignment",
      "id": "heading_alignment",
      "label": "t:sections.brands-logo.settings.heading_alignment.label",
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:sections.brands-logo.settings.header_image.content"
    },    
    {
      "type": "select",
      "id": "image_width",
      "options": [
        {
          "value": "third",
          "label": "t:sections.brands-logo.settings.image_width.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.brands-logo.settings.image_width.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.brands-logo.settings.image_width.options__3.label"
        }
      ],
      "default": "full",
      "label": "t:sections.brands-logo.settings.image_width.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.brands-logo.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.brands-logo.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.brands-logo.settings.image_ratio.options__3.label"
        },
        {
          "value": "circle",
          "label": "t:sections.brands-logo.settings.image_ratio.options__4.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.brands-logo.settings.image_ratio.label"
    },
    {
      "type": "header",
      "content": "t:sections.brands-logo.settings.header_button.content"
    },    
    {
      "type": "text",
      "id": "button_label",
      "default": "t:sections.brands-logo.settings.button_label.default",
      "label": "t:sections.brands-logo.settings.button_label.label", 
      "info": "t:sections.brands-logo.settings.button_label.info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.brands-logo.settings.button_link.label"
    },    
    {
      "type": "header",
      "content": "t:sections.brands-logo.settings.header_layout.content"
    },     
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 2,
      "label": "t:sections.brands-logo.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "column_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.brands-logo.settings.column_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.brands-logo.settings.column_alignment.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.brands-logo.settings.column_alignment.label"
    },
    {
      "type": "select",
      "id": "background_style",
      "options": [
        {
          "value": "none",
          "label": "t:sections.brands-logo.settings.background_style.options__1.label"
        },
        {
          "value": "primary",
          "label": "t:sections.brands-logo.settings.background_style.options__2.label"
        }
      ],
      "default": "primary",
      "label": "t:sections.brands-logo.settings.background_style.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "content_colors",
      "label": "t:sections.all.content_colors.label",
      "default": "scheme-1",
      "visible_if": "{{ section.settings.background_style == 'primary' }}"
    },    
    {
      "type": "header",
      "content": "t:sections.brands-logo.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.brands-logo.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.brands-logo.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "1",
      "label": "t:sections.brands-logo.settings.columns_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": false,
      "label": "t:sections.brands-logo.settings.swipe_on_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "brand-logo",
      "name": "t:sections.brands-logo.blocks.brand-logo.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.brands-logo.blocks.brand-logo.settings.image.label"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:sections.brands-logo.blocks.brand-logo.settings.title.label"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.brands-logo.blocks.brand-logo.settings.text.label"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.brands-logo.blocks.brand-logo.settings.link_label.label",
          "info": "t:sections.brands-logo.blocks.brand-logo.settings.link_label.info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.brands-logo.blocks.brand-logo.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.brands-logo.presets.name",
      "blocks": [
        {
          "type": "brand-logo"
        },
        {
          "type": "brand-logo"
        },
        {
          "type": "brand-logo"
        }
      ]
    }
  ]
}
{% endschema %}
