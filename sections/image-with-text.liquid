{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% if section.settings.background_image != blank %}
    .section-{{ section.id }} .image-with-text-inner {
      background-image: url('{{- section.settings.background_image | image_url -}}');
    }
  {% endif %}

  {% if section.settings.custom_class == 'pwk-image-text' %}

    /* Description field */
    .section-{{ section.id }}.pwk-image-text .description.rte,
    .section-{{ section.id }}.pwk-image-text .description.rte p,
    .section-{{ section.id }}.pwk-image-text .description.rte span,
    .section-{{ section.id }}.pwk-image-text .description.rte * {
      font-size: 22px !important;
      line-height: 31.5px !important;
    }

    /* Box content text - Desktop */
    .section-{{ section.id }}.pwk-image-text .box-content-content,
    .section-{{ section.id }}.pwk-image-text .box-content-content p,
    .section-{{ section.id }}.pwk-image-text .box-content-content span,
    .section-{{ section.id }}.pwk-image-text .box-content-content * {
      font-size: 22px !important;
      line-height: 31.5px !important;
    }

    /* Box content text - Mobile */
    @media screen and (max-width: 749px) {
      .section-{{ section.id }}.pwk-image-text .box-content-content,
      .section-{{ section.id }}.pwk-image-text .box-content-content p,
      .section-{{ section.id }}.pwk-image-text .box-content-content span,
      .section-{{ section.id }}.pwk-image-text .box-content-content * {
        font-size: 14px !important;
        line-height: 19.6px !important;
      }
    }

    /* Mobile */
    @media screen and (max-width: 749px) {
      .section-{{ section.id }}.pwk-image-text .description.rte,
      .section-{{ section.id }}.pwk-image-text .description.rte p,
      .section-{{ section.id }}.pwk-image-text .description.rte span,
      .section-{{ section.id }}.pwk-image-text .description.rte * {
        font-size: 14px !important;
        line-height: 19.6px !important;
      }
    }

  {% endif %}

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {% if section.settings.custom_class == 'control_env' %}

    /* control_env - desktop layout */
    .section-{{ section.id }}.control_env .image-with-text__grid {
      display: flex !important;
      /* align-items: center !important; */
    }

    .section-{{ section.id }}.control_env .image-with-text__text-item {
      width: 45% !important;
      max-width: 45% !important;
      flex: 0 0 45% !important;
    }

    .section-{{ section.id }}.control_env .image-with-text__media-item {
      width: 55% !important;
      max-width: 55% !important;
      flex: 0 0 55% !important;

      display: flex !important;
      /* align-items: flex-end !important; */
      justify-content: center !important;
    }

    .section-{{ section.id }}.control_env .image-with-text__media {
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 auto !important;
    }

    .section-{{ section.id }}.control_env .image-with-text__media img {
      width: 100% !important;
      height: auto !important;
      object-fit: contain !important;
    }

    /* Mobile */
    @media screen and (max-width: 749px) {

      .section-{{ section.id }}.control_env .image-with-text__text-item,
      .section-{{ section.id }}.control_env .image-with-text__media-item {
        width: 100% !important;
        max-width: 100% !important;
        flex: 0 0 100% !important;
      }

      .section-{{ section.id }}.control_env .image-with-text__media {
        width: 80% !important;
        max-width: 80% !important;
      }

    }

    /* Caption */
    .section-{{ section.id }} .image-with-text__text--caption {
      font-size: 36px !important;
      line-height: 1.4 !important;
    }

    /* Heading */
    .section-{{ section.id }} .image-with-text__heading,
    .section-{{ section.id }} .image-with-text__heading * {
      font-size: 100px !important;
      line-height: 60px !important;
    }

    /* Text */
    .section-{{ section.id }} .image-with-text__text.rte {
      font-size: 20px !important;
      line-height: 1.4 !important;
    }

    /* Mobile */
    @media screen and (max-width: 749px) {

      .section-{{ section.id }} .image-with-text__text--caption {
        font-size: 20px !important;
        line-height: 1.4 !important;
      }

      .section-{{ section.id }} .image-with-text__heading,
      .section-{{ section.id }} .image-with-text__heading *,
      .section-{{ section.id }} .image-with-text__heading span,
      .section-{{ section.id }} .image-with-text__heading strong {
        font-size: 60px !important;
        line-height: 35px !important;
        display: block;
      }

      .section-{{ section.id }} .image-with-text__text.rte {
        font-size: 14px !important;
        line-height: 1.4 !important;
      }

    }

    /* Reduce spacing between Caption and Heading */
    .section-{{ section.id }} .image-with-text__text--caption {
      margin-bottom: 10px !important;
    }

    .section-{{ section.id }} .image-with-text__heading {
      margin-top: 0 !important;
    }

  {% endif %}

  {% if section.settings.custom_class == 'about_kris_g' %}

    /* Caption - Desktop */
    .section-{{ section.id }}.about_kris_g .image-with-text__text--caption {
      font-size: 52px !important;
      line-height: 1.4 !important;
    }

    /* Heading - Desktop */
    .section-{{ section.id }}.about_kris_g .image-with-text__heading,
    .section-{{ section.id }}.about_kris_g .image-with-text__heading * {
      font-size: 100px !important;
      line-height: 60px !important;
    }

    /* Body Text - Desktop */
    .section-{{ section.id }} .about-kris-text,
    .section-{{ section.id }} .about-kris-text p,
    .section-{{ section.id }} .about-kris-text * {
      font-size: 20px !important;
      line-height: 26px !important;
    }

    /* Mobile */
    @media screen and (max-width: 749px) {

      .section-{{ section.id }}.about_kris_g .image-with-text__text--caption {
        font-size: 40px !important;
        line-height: 1.4 !important;
      }

      .section-{{ section.id }}.about_kris_g .image-with-text__heading,
      .section-{{ section.id }}.about_kris_g .image-with-text__heading * {
        font-size: 60px !important;
        line-height: 35px !important;
      }

      .section-{{ section.id }} .about-kris-text,
      .section-{{ section.id }} .about-kris-text p,
      .section-{{ section.id }} .about-kris-text * {
        font-size: 14px !important;
        line-height: 18.2px !important;
      }

    }

  {% endif %}

  /* .section-{{ section.id }} .image-with-text__grid {
    align-items: center !important;
  } */

  .section-{{ section.id }} .image-with-text__content {
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    height: 100% !important;
  }

  {% if section.settings.custom_class == 'gethinverse-image-text' %}

    .section-{{ section.id }} .description.rte {
      font-size: 2.25rem !important;
      line-height: 1.4 !important;
    }

    /* Box heading - Desktop & Tablet */
    .section-{{ section.id }} .box-content-heading,
    .section-{{ section.id }} .box-content-heading * {
      font-size: 30px !important;
      line-height: 30px !important;
    }

    /* Box content text - Desktop & Tablet */
    .section-{{ section.id }} .box-content-content,
    .section-{{ section.id }} .box-content-content *,
    .section-{{ section.id }} .box-content-content p,
    .section-{{ section.id }} .box-content-content span {
      font-size: 22px !important;
      line-height: 31.5px !important;
    }

    /* Mobile */
    @media screen and (max-width: 749px) {

      .section-{{ section.id }} .box-content-heading,
      .section-{{ section.id }} .box-content-heading * {
        font-size: 18px !important;
        line-height: 19.6px !important;
      }

      .section-{{ section.id }} .box-content-content,
      .section-{{ section.id }} .box-content-content *,
      .section-{{ section.id }} .box-content-content p,
      .section-{{ section.id }} .box-content-content span {
        font-size: 14px !important;
        line-height: 19.6px !important;
      }

    }

    /* Main heading subblock */
    .section-{{ section.id }} .image-with-text__heading {
      font-size: 5rem !important;
      line-height: 1 !important;
    }

  {% endif %}

  {% if section.settings.custom_class == 'pwk-image-text' %}

    /* Description field */
    .section-{{ section.id }} .description.rte,
    .section-{{ section.id }} .description.rte * {
      font-size: 2rem !important;
      line-height: 1 !important;
    }

    /* Box content text */
    .section-{{ section.id }} .box-content-content,
    .section-{{ section.id }} .box-content-content * {
      font-size: 2rem !important;
      line-height: 1.4 !important;
    }

  {% endif %}

  /* MOBILE - Description field */
  @media screen and (max-width: 749px) {

    .section-{{ section.id }} .description.rte,
    .section-{{ section.id }} .description.rte * {
      font-size: 1.4rem !important;
      line-height: 1.4 !important;
    }

  }

  /* Bottom-align the image column without stretching the media box */
  /* .section-{{ section.id }} .image-with-text__grid {
    align-items: flex-end !important;
  } */

  /* Keep image responsive */
  .section-{{ section.id }} .image-with-text__media {
    width: 100% !important;
  }

  .section-{{ section.id }} .image-with-text__media img {
    display: block !important;
    width: 100% !important;
    height: auto !important;
    object-fit: contain !important;
    object-position: bottom center !important;
  }

  /* Caption - Desktop */
  .section-{{ section.id }}.control_env .image-with-text__text--caption {
    font-size: 36px !important;
    line-height: 50px !important;
  }

  /* Heading - Desktop */
  .section-{{ section.id }}.control_env .image-with-text__heading,
  .section-{{ section.id }}.control_env .image-with-text__heading *,
  .section-{{ section.id }}.control_env .image-with-text__heading span,
  .section-{{ section.id }}.control_env .image-with-text__heading strong {
    font-size: 100px !important;
    line-height: 60px !important;
  }

  /* Tablet */
  @media screen and (min-width: 1077px) and (max-width: 1570px) {

    .section-{{ section.id }}.control_env .image-with-text__text--caption {
      font-size: 28px !important;
      line-height: 39px !important;
    }

    .section-{{ section.id }}.control_env .image-with-text__heading,
    .section-{{ section.id }}.control_env .image-with-text__heading *,
    .section-{{ section.id }}.control_env .image-with-text__heading span,
    .section-{{ section.id }}.control_env .image-with-text__heading strong {
      font-size: 72px !important;
      line-height: 46px !important;
    }

  }

  /* Mobile */
  @media screen and (max-width: 1077px) {

    .section-{{ section.id }}.control_env .image-with-text__text--caption {
      font-size: 20px !important;
      line-height: 28px !important;
    }

    .section-{{ section.id }}.control_env .image-with-text__heading,
    .section-{{ section.id }}.control_env .image-with-text__heading *,
    .section-{{ section.id }}.control_env .image-with-text__heading span,
    .section-{{ section.id }}.control_env .image-with-text__heading strong {
      font-size: 48px !important;
      line-height: 34px !important;
    }

  }

  /* .section-{{ section.id }} .image-with-text__text-item {
    align-self: flex-start !important;
  } */

  {% if section.settings.custom_class == 'control_env' %}
    .section-{{ section.id }}.control_env .image-with-text__text-item {
      display: flex !important;
      /* align-items: center !important;
      align-self: center !important; */
    }

    .section-{{ section.id }}.control_env .image-with-text__content {
      display: flex !important;
      flex-direction: column !important;
      justify-content: center !important;
      height: 100% !important;
    }

  {% endif %}

  /* Bullet indentation only for the about_kris_g custom class */
  .about_kris_g .rte ul,
  .about_kris_g .rte ol {
    list-style-position: outside !important;
    padding-left: 2.2rem !important;
    margin-left: 0 !important;
  }

  .about_kris_g .rte li {
    padding-left: 0.4rem !important;
  }
{%- endstyle -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  if section.settings.color_scheme == section.settings.section_color_scheme and section.settings.content_layout == 'no-overlap'
    assign remove_color_classes = true
  endif
-%}

<div {% if section.settings.scroll_id != blank %}id="{{ section.settings.scroll_id }}"{% endif %} class="image-with-text-wrapper{% if section.settings.custom_class != blank %} {{  section.settings.custom_class }}{% endif %}{% if section.settings.background_image != blank %} has_background{% endif %} section-{{ section.id }} gradient color-{{ section.settings.section_color_scheme }}">
  {% if section.settings.custom_class == 'control_env' %}
    <div class="line_icon">
      <span class="svg-wrapper">
        {{- "icon-center-line-bottom-border.svg" | inline_asset_content -}}
      </span>
    </div>
  {% endif %}
  {% if section.settings.custom_class == 'about_kris_g' %}
    <div class="line_icon">
      <span class="svg-wrapper">
        {{- "icon-center-line-top-border.svg" | inline_asset_content -}}
      </span>
    </div>
  {% endif %}
  <div class="image-with-text-inner section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}">
    {%- if section.settings.title != blank or section.settings.description != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin page-width {{ section.settings.heading_alignment }}">
        {% if section.settings.title != blank %}
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="description rte">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>
    {%- endif -%}
    <div class="{% if section.settings.full_width %}full-width{% else %}page-width{% endif %}">
      <div class="image-with-text image-with-text--{{ section.settings.content_layout }} isolate{% if settings.text_boxes_border_thickness > 0 and settings.text_boxes_border_opacity > 0 and settings.media_border_thickness > 0 and settings.media_border_opacity > 0 %} collapse-borders{% endif %}{% unless section.settings.color_scheme == section.settings.section_color_scheme and settings.media_border_thickness > 0 and settings.text_boxes_shadow_opacity == 0 and settings.text_boxes_border_thickness == 0 or settings.text_boxes_border_opacity == 0 %} collapse-corners{% endunless %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <div class="image-with-text__grid grid grid--gapless grid--1-col grid--{% if section.settings.desktop_image_width == 'medium' %}2-col-tablet{% else %}3-col-tablet{% endif %}{% if section.settings.layout == 'text_first' %} image-with-text__grid--reverse{% endif %}{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}">
          <div class="image-with-text__media-item image-with-text__media-item--{{ section.settings.desktop_image_width }} image-with-text__media-item--{{ section.settings.desktop_content_position }} grid__item">
            <div
              class="dekstop_image image-with-text__media image-with-text__media--{{ section.settings.height }} global-media-settings{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}{% if section.settings.image != blank %} media{% else %} image-with-text__media--placeholder placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}"
              {% if section.settings.height == 'adapt' and section.settings.image != blank %}
                style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
              {% endif %}
            >
              {%- if section.settings.image != blank -%}
                {%- if section.settings.image_behavior == 'ambient' or section.settings.image_behavior == 'zoom-in' -%}
                  {%- assign widths = '198, 432, 642, 900, 1284, 1800' -%}
                  {%- capture sizes -%}
                    (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                    (min-width: 750px) calc((100vw - 130px) / 2),
                    calc(100vw - 50px)
                  {%- endcapture -%}
                {%- else -%}
                  {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
                  {%- capture sizes -%}
                    (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                    (min-width: 750px) calc((100vw - 130px) / 2),
                    calc(100vw - 50px)
                  {%- endcapture -%}
                {%- endif -%}
                {{
                  section.settings.image
                  | image_url: width: 1500
                  | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
                }}
              {%- else -%}
                {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

            {%- if section.settings.mobile_image != blank -%}
              <div
                class="mobile_image image-with-text__media image-with-text__media--{{ section.settings.height }} global-media-settings{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}{% if section.settings.image != blank %} media{% else %} image-with-text__media--placeholder placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}"
                {% if section.settings.height == 'adapt' and section.settings.mobile_image != blank %}
                  style="padding-bottom: {{ 1 | divided_by: section.settings.mobile_image.aspect_ratio | times: 100 }}%;"
                {% endif %}
              >
                  {%- if section.settings.image_behavior == 'ambient' or section.settings.image_behavior == 'zoom-in' -%}
                    {%- assign widths = '198, 432, 642, 900, 1284, 1800' -%}
                    {%- capture sizes -%}
                      (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                      (min-width: 750px) calc((100vw - 130px) / 2),
                      calc(100vw - 50px)
                    {%- endcapture -%}
                  {%- else -%}
                    {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
                    {%- capture sizes -%}
                      (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                      (min-width: 750px) calc((100vw - 130px) / 2),
                      calc(100vw - 50px)
                    {%- endcapture -%}
                  {%- endif -%}
                  {{
                    section.settings.mobile_image
                    | image_url: width: 1500
                    | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
                  }}
              </div>
              {% else %}
                <div
                  class="mobile_image image-with-text__media image-with-text__media--{{ section.settings.height }} global-media-settings{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}{% if section.settings.image != blank %} media{% else %} image-with-text__media--placeholder placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}"
                  {% if section.settings.height == 'adapt' and section.settings.image != blank %}
                    style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
                  {% endif %}
                >
                  {%- if section.settings.image != blank -%}
                    {%- if section.settings.image_behavior == 'ambient' or section.settings.image_behavior == 'zoom-in' -%}
                      {%- assign widths = '198, 432, 642, 900, 1284, 1800' -%}
                      {%- capture sizes -%}
                        (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                        (min-width: 750px) calc((100vw - 130px) / 2),
                        calc(100vw - 50px)
                      {%- endcapture -%}
                    {%- else -%}
                      {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
                      {%- capture sizes -%}
                        (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                        (min-width: 750px) calc((100vw - 130px) / 2),
                        calc(100vw - 50px)
                      {%- endcapture -%}
                    {%- endif -%}
                    {{
                      section.settings.image
                      | image_url: width: 1500
                      | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
                    }}
                  {%- else -%}
                    {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
              {%- endif -%}
          </div>
          <div class="image-with-text__text-item grid__item">
            <div
              id="ImageWithText--{{ section.id }}"
              class="image-with-text__content image-with-text__content--{{ section.settings.desktop_content_position }} image-with-text__content--desktop-{{ section.settings.desktop_content_alignment }} image-with-text__content--mobile-{{ section.settings.mobile_content_alignment }} image-with-text__content--{{ section.settings.height }} content-container{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}"
            >
              {%- for block in section.blocks -%}
                {% case block.type %}
                  {%- when 'heading' -%}
                    <h2
                      class="image-with-text__heading inline-richtext {{ block.settings.heading_size }}"
                      {% if section.settings.custom_class == 'control_env' %}
                        style="font-size: 100px !important; line-height: 55.7px !important;"
                      {% endif %}
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.heading }}
                    </h2>
                  {%- when 'caption' -%}
                    <p
                      class="image-with-text__text image-with-text__text--caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }} {{ block.settings.text_style }}"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.caption | escape }}
                    </p>
                  {%- when 'text' -%}
                    <div
                      class="image-with-text__text rte {{ block.settings.text_style }}{% if section.settings.custom_class == 'about_kris_g' %} about-kris-text{% endif %}"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.text }}
                    </div>
                  {%- when 'box_content' -%}
                    <div class="box-content-wrapper">
                      <div class="box-content gradient color-{{ block.settings.color_scheme }}">
                        {% if block.settings.heading != blank %}
                          <h3 class="inline-richtext box-content-heading">{{ block.settings.heading }}</h3>
                        {% endif %}
                        {% if block.settings.content != blank %}
                          <div class="box-content-content rte">
                            {{ block.settings.content }}
                          </div>
                        {% endif %}
                      </div>
                    </div>
                  {%- when 'button' -%}
                    {%- if block.settings.button_label != blank -%}
                      <a
                        {% if block.settings.button_link == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.button_link }}"
                        {% endif %}
                        class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                        {{ block.shopify_attributes }}
                      >
                        <span>{{ block.settings.button_label | escape }}</span>
                      </a>
                    {%- endif -%}
                  {%- when 'signature_image' -%}
                    {%- if block.settings.image != blank -%}
                      <div class="image-with-text__signature_image">    
                        <div class="media media--transparent media--adapt" style="padding-bottom: {{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;">
                          <img src="{{- block.settings.image | image_url -}}" width="{{- block.settings.image.width -}}" height="{{- block.settings.image.height -}}" alt="{{- block.settings.image.alt -}}" loading="lazy" fetchpriority="auto" />
                        </div>
                      </div> 
                    {%- endif -%}
                {%- endcase -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

