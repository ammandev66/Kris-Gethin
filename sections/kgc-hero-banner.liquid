{%- liquid
  assign desktop_img = section.settings.image_desktop
  assign mobile_img = section.settings.image_mobile | default: desktop_img

  assign is_first = false
  if section.index == 1
    assign is_first = true
  endif

  assign heading_tag = 'h2'
  if is_first
    assign heading_tag = 'h1'
  endif

  assign btn_tag = 'span'
  if section.settings.button_link != blank
    assign btn_tag = 'a'
  endif

  assign member_tag = 'span'
  if section.settings.member_link != blank
    assign member_tag = 'a'
  endif

  assign cols = section.blocks.size

  assign pad_top = section.settings.padding_top
  assign pad_top_vw = pad_top | divided_by: 25.6 | round: 3
  assign pad_top_min = pad_top | times: 0.4 | round

  assign pad_bottom = section.settings.padding_bottom
  assign pad_bottom_vw = pad_bottom | divided_by: 25.6 | round: 3
  assign pad_bottom_min = pad_bottom | times: 0.4 | round
-%}

{%- style -%}
  .kgc-hero-{{ section.id }} {
    --kgc-bg: {{ section.settings.bg_color }};
    --kgc-color: {{ section.settings.text_color }};
    --kgc-cols: {{ cols }};
    --kgc-pad-top: clamp({{ pad_top_min }}px, {{ pad_top_vw }}vw, {{ pad_top }}px);
    --kgc-pad-bottom: clamp({{ pad_bottom_min }}px, {{ pad_bottom_vw }}vw, {{ pad_bottom }}px);
  }
{%- endstyle -%}

<div class="kgc-hero kgc-hero-{{ section.id }}">
  {%- if mobile_img != blank or desktop_img != blank -%}
    <picture class="kgc-hero__media">
      {%- if desktop_img != blank -%}
        <source
          media="(min-width: 750px)"
          srcset="
            {{ desktop_img | image_url: width: 750 }} 750w,
            {{ desktop_img | image_url: width: 1100 }} 1100w,
            {{ desktop_img | image_url: width: 1500 }} 1500w,
            {{ desktop_img | image_url: width: 2000 }} 2000w,
            {{ desktop_img | image_url: width: 2560 }} 2560w
          "
          sizes="100vw"
        >
      {%- endif -%}
      <img
        class="kgc-hero__image"
        src="{{ mobile_img | image_url: width: 800 }}"
        srcset="
          {{ mobile_img | image_url: width: 400 }} 400w,
          {{ mobile_img | image_url: width: 600 }} 600w,
          {{ mobile_img | image_url: width: 800 }} 800w,
          {{ mobile_img | image_url: width: 1000 }} 1000w
        "
        sizes="100vw"
        width="{{ mobile_img.width }}"
        height="{{ mobile_img.height }}"
        alt=""
        {% if is_first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
      >
    </picture>
  {%- endif -%}

  <div class="kgc-hero__overlay" aria-hidden="true"></div>

  <div class="kgc-hero__inner">
    <div class="kgc-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="kgc-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading_accent != blank or section.settings.heading_main != blank or section.settings.title != blank -%}
        <{{ heading_tag }} class="kgc-hero__heading">
          {%- if section.settings.heading_accent != blank or section.settings.heading_main != blank -%}
            <span class="kgc-hero__brand">
              {%- if section.settings.heading_accent != blank -%}
                <span class="kgc-hero__accent">{{ section.settings.heading_accent | escape }}</span>
              {%- endif -%}
              {{- section.settings.heading_main | escape -}}
            </span>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <span class="kgc-hero__title">{{ section.settings.title | escape }}</span>
          {%- endif -%}
        </{{ heading_tag }}>
      {%- endif -%}

      {%- if section.settings.badge != blank -%}
        <h3 class="kgc-hero__badge">{{ section.settings.badge | escape }}</h3>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="kgc-hero__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="kgc-hero__description">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if section.settings.button_text != blank -%}
        <{{ btn_tag }}
          class="kgc-hero__button"
          {% if btn_tag == 'a' %}href="{{ section.settings.button_link }}"{% endif %}
        >
          {{- section.settings.button_text | escape -}}
        </{{ btn_tag }}>
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <p class="kgc-hero__note">{{ section.settings.note | escape }}</p>
      {%- endif -%}

      {%- if section.settings.member_text != blank or section.settings.member_link_text != blank -%}
        <p class="kgc-hero__member">
          {{- section.settings.member_text | escape }}
          {% if section.settings.member_link_text != blank -%}
            <{{ member_tag }}
              class="kgc-hero__member-link"
              {% if member_tag == 'a' %}href="{{ section.settings.member_link }}"{% endif %}
            >
              {{- section.settings.member_link_text | escape -}}
            </{{ member_tag }}>
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>

    {%- if cols > 0 -%}
      <div class="kgc-hero__stats">
        {%- for block in section.blocks -%}
          <div class="kgc-hero__stat" {{ block.shopify_attributes }}>
            {%- if block.settings.stat_title != blank -%}
              <h4 class="kgc-hero__stat-title">{{ block.settings.stat_title | escape }}</h4>
            {%- endif -%}
            {%- if block.settings.stat_text != blank -%}
              <p class="kgc-hero__stat-text">{{ block.settings.stat_text | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .kgc-hero {
    --kgc-accent: #e8001c;
    --kgc-on-accent: #ffffff;
    --kgc-line: rgba(255, 255, 255, 0.2);
    --kgc-overlay: rgba(0, 0, 0, 0.55);
    --kgc-pos: center;
    /* 141px @2560px */
    --kgc-side: clamp(16px, 5.5vw, 141px);

    position: relative;
    isolation: isolate;
    box-sizing: border-box;
    width: 100%;
    overflow: hidden;
    background-color: var(--kgc-bg);
    color: var(--kgc-color);
    padding-top: var(--kgc-pad-top);
    padding-bottom: var(--kgc-pad-bottom);
    padding-left: var(--kgc-side);
    padding-right: var(--kgc-side);
  }

  .kgc-hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    display: block;
  }

  .kgc-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--kgc-pos);
  }

  .kgc-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--kgc-overlay);
    pointer-events: none;
  }

  .kgc-hero__inner {
    position: relative;
    box-sizing: border-box;
    width: 100%;
  }

  /* ---------- Content ---------- */
  .kgc-hero__content {
    box-sizing: border-box;
    max-width: 100%;
  }

  .kgc-hero__eyebrow {
    margin: 0;
    color: var(--kgc-color);
    /* 22px @2560px */
    font-size: clamp(0.625rem, 0.496rem + 0.549vw, 1.375rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #B8B8BE;
  }

  .kgc-hero__heading {
    margin: clamp(12px, 2.5vw, 64px) 0 0;
    color: var(--kgc-color);
    font-weight: 800;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .kgc-hero__brand {
    display: block;
    /* 168px @2560px */
    font-size: clamp(2.75rem, 6.5625vw, 10.5rem);
    line-height: 1;
    font-family: 'Montserrat', sans-serif;
    letter-spacing: -5px;
  }

  .kgc-hero__accent {
    color: var(--kgc-accent);
  }

  .kgc-hero__title {
    display: block;
    margin-top: clamp(0px, 0.4vw, 10px);
    /* 140px @2560px */
    font-size: clamp(2.25rem, 5.469vw, 8.75rem);
    line-height: 1;
    font-weight: 400;
  }

  .kgc-hero__badge {
    display: block;
    box-sizing: border-box;
    width: fit-content;
    max-width: 100%;
    /* 738px @2560px */
    min-width: clamp(240px, 28.83vw, 738px);
    margin-top: clamp(10px, 2vw, 51px);
    padding: clamp(6px, 0.75vw, 19px) clamp(10px, 1.2vw, 31px);
    background-color: var(--kgc-accent);
    color: var(--kgc-on-accent);
    /* 44px @2560px */
    font-size: clamp(1rem, 0.699rem + 1.281vw, 2.75rem);
    font-weight: 400;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .kgc-hero__subheading {
    margin: clamp(12px, 1.9vw, 49px) 0 0;
    color: var(--kgc-color);
    /* 48px @2560px */
    font-size: clamp(1.125rem, 0.803rem + 1.373vw, 3rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .kgc-hero__description {
    margin-top: clamp(10px, 1.9vw, 49px);
    color: var(--kgc-color);
    opacity: 0.85;
    /* 34px @2560px */
    font-size: clamp(0.875rem, 0.661rem + 0.915vw, 2.125rem);
    line-height: 1.55;
  }

  .kgc-hero__description p {
    margin: 0 0 0.8em;
  }

  .kgc-hero__description p:last-child {
    margin-bottom: 0;
  }

  /* ---------- Button (clipped corners) ---------- */
  .kgc-hero__button {
    --kgc-cut: clamp(8px, 1.406vw, 36px);

    display: block;
    box-sizing: border-box;
    width: fit-content;
    max-width: 100%;
    /* 890px @2560px */
    min-width: clamp(260px, 34.77vw, 890px);
    margin-top: clamp(16px, 1.5vw, 38px);
    padding: clamp(12px, 1.6vw, 41px) clamp(16px, 2vw, 51px);
    background-color: var(--kgc-accent);
    color: var(--kgc-on-accent);
    /* 26px @2560px */
    font-size: clamp(0.6875rem, 0.527rem + 0.686vw, 1.625rem);
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    clip-path: polygon(
      0 0,
      calc(100% - var(--kgc-cut)) 0,
      100% var(--kgc-cut),
      100% 100%,
      var(--kgc-cut) 100%,
      0 calc(100% - var(--kgc-cut))
    );
    transition: filter 0.3s ease;
  }

  @media (hover: hover) {
    a.kgc-hero__button:hover {
      filter: brightness(1.15);
    }
  }

  a.kgc-hero__button:focus-visible {
    outline: 2px solid var(--kgc-color);
    outline-offset: 2px;
  }

  .kgc-hero__note,
  .kgc-hero__member {
    margin: 0;
    color: var(--kgc-color);
    /* 22px @2560px */
    font-size: clamp(0.625rem, 0.496rem + 0.549vw, 1.375rem);
    line-height: 1.3;
  }

  .kgc-hero__note {
    margin-top: clamp(8px, 1.1vw, 28px);
    opacity: 0.7;
  }

  .kgc-hero__member {
    margin-top: clamp(8px, 1vw, 26px);
    font-weight: 600;
  }

  .kgc-hero__member-link {
    margin-left: 0.4em;
    color: var(--kgc-accent);
    text-decoration: none;
    text-transform: uppercase;
  }

  @media (hover: hover) {
    a.kgc-hero__member-link:hover {
      text-decoration: underline;
    }
  }

  /* ---------- Stats ---------- */
  .kgc-hero__stats {
    display: grid;
    grid-template-columns: 1fr;
    margin-top: clamp(24px, 3.8vw, 98px);
    border: 1px solid var(--kgc-line);
    background-color: rgba(0, 0, 0, 0.55);
  }

  .kgc-hero__stat {
    box-sizing: border-box;
    min-width: 0;
    padding: clamp(14px, 2vw, 51px) clamp(8px, 1vw, 26px);
    text-align: center;
    color: var(--kgc-color);
  }

  .kgc-hero__stat + .kgc-hero__stat {
    border-top: 1px solid var(--kgc-line);
  }

  .kgc-hero__stat-title {
    margin: 0;
    /* 44px @2560px */
    font-size: clamp(1.125rem, 0.846rem + 1.19vw, 2.75rem);
    font-weight: 400;
    line-height: 1.1;
    text-transform: uppercase;
    overflow-wrap: anywhere;
    color: #fff;
  }

  .kgc-hero__stat-text {
    margin: clamp(2px, 0.3vw, 8px) 0 0;
    opacity: 0.7;
    /* 21px @2560px */
    font-size: clamp(0.625rem, 0.507rem + 0.503vw, 1.3125rem);
    line-height: 1.3;
  }

  /* ---------- Desktop ---------- */
  @media screen and (min-width: 750px) {
    .kgc-hero {
      --kgc-pos: right center;
      --kgc-overlay: linear-gradient(90deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 60%);
    }

    .kgc-hero__content {
      max-width: 60%;
    }

    .kgc-hero__stats {
      grid-template-columns: repeat(var(--kgc-cols), minmax(0, 1fr));
    }

    .kgc-hero__stat + .kgc-hero__stat {
      border-top: 0;
      border-left: 1px solid var(--kgc-line);
    }
  }

  @media screen and (min-width: 1200px) {
    .kgc-hero__content {
      /* 1063px @2560px */
      max-width: clamp(0px, 41.5vw, 1063px);
    }
  }
  @media(max-width: 767px){
    .kgc-hero__brand{
        letter-spacing: normal;
    }
  }
</style>

{% schema %}
{
  "name": "KGC Hero Banner",
  "tag": "section",
  "class": "kgc-hero-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small top text",
      "default": "The Homecore Transformation Challenge"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading (red part)",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "heading_main",
      "label": "Heading (main part)",
      "default": "Core"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading second line",
      "default": "Transformation Challenge"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Red badge text",
      "default": "Muscle Building Edition"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Your January reset starts before January."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Start October 19 with Kris Gethin's Homecore Daily Video Trainer—and turn your commitment into a transformation worth celebrating.</p><p>Train from home or the gym. Follow a plan. Build consistency inside the Gethinverse community.</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Join Gethinverse & enter the challenge"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small note",
      "default": "Free to enter with your Gethinverse membership."
    },
    {
      "type": "text",
      "id": "member_text",
      "label": "Member text",
      "default": "Already a member?"
    },
    {
      "type": "text",
      "id": "member_link_text",
      "label": "Member link text",
      "default": "Enter the challenge"
    },
    {
      "type": "url",
      "id": "member_link",
      "label": "Member link"
    },
    {
      "type": "header",
      "content": "Background images"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Desktop image is used if left empty."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Content color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "#050505"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 128
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 92
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat box",
      "settings": [
        {
          "type": "text",
          "id": "stat_title",
          "label": "Title",
          "default": "12 Weeks"
        },
        {
          "type": "text",
          "id": "stat_text",
          "label": "Text",
          "default": "A structured plan"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KGC Hero Banner",
      "blocks": [
        {
          "type": "stat",
          "settings": { "stat_title": "12 Weeks", "stat_text": "A structured plan" }
        },
        {
          "type": "stat",
          "settings": { "stat_title": "Daily Video", "stat_text": "Guidance from Kris" }
        },
        {
          "type": "stat",
          "settings": { "stat_title": "Home or Gym", "stat_text": "Train your way" }
        }
      ]
    }
  ]
}
{% endschema %}