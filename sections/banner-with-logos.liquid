{{ 'banner-with-logos.css' | asset_url | stylesheet_tag }}

{%- if section.settings.image_height == 'adapt' and section.settings.image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #banner-with-logos-{{ section.id }}::before,
      #banner-with-logos-{{ section.id }} .banner-with-logos__media::before,
      #banner-with-logos-{{ section.id }}:not(.banner-with-logos--mobile-bottom) .banner-with-logos__content::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    
      #banner-with-logos-{{ section.id }}::before,
      #banner-with-logos-{{ section.id }} .mobile-image::before,
      #banner-with-logos-{{ section.id }}:not(.banner-with-logos--mobile-bottom) .banner-with-logos__content::before {
        padding-bottom: {{ 1 | divided_by: section.settings.mobile_image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }

    @media screen and (min-width: 750px) {
      #banner-with-logos-{{ section.id }}::before,
      #banner-with-logos-{{ section.id }} .banner-with-logos__media::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{%- style -%}
  #banner-with-logos-{{ section.id }}::after {
    opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
  }

  /* =========================
    Heading Font Size & Line Height
    ========================= */
  #banner-with-logos-{{ section.id }} .banner-with-logos__heading {
    font-size: 74px !important;
    line-height: 0.8 !important;
  }

  /* =========================
    Text Block Font Size & Line Height
    ========================= */
  #banner-with-logos-{{ section.id }} .banner-with-logos__text,
  #banner-with-logos-{{ section.id }} .banner-with-logos__text p {
    font-size: 20px !important;
    line-height: 26px !important;
  }

  /* =========================
    Mobile Styles
    ========================= */
  @media screen and (max-width: 749px) {
    #banner-with-logos-{{ section.id }} .banner-with-logos__heading {
      font-size: 40px !important;
      line-height: 0.8 !important;
    }

    #banner-with-logos-{{ section.id }} .banner-with-logos__text,
    #banner-with-logos-{{ section.id }} .banner-with-logos__text p {
      font-size: 14px !important;
      line-height: 18.2px !important;
    }
  }

{%- endstyle -%}

{%- liquid
  assign full_width = '100vw'
  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'

  if section.settings.image_behavior == 'ambient'
    assign half_width = '60vw'
    assign full_width = '120vw'
    assign stacked_sizes = '(min-width: 750px) 60vw, 120vw'
    assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
  elsif section.settings.image_behavior == 'fixed' or section.settings.image_behavior == 'zoom-in'
    assign half_width = '100vw'
    assign stacked_sizes = '100vw'
  else
    assign half_width = '50vw'
    assign stacked_sizes = '(min-width: 750px) 50vw, 100vw'
  endif
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif

  assign has_logos = 0
  for block in section.blocks
    case block.type
      when 'logos'
        assign has_logos = has_logos | plus: 1
    endcase
  endfor
-%}

<div class="banner-with-logos-wrapper color-{{ section.settings.color_scheme }} gradient">
  <div class="banner-with-logos-inner color-{{ section.settings.color_scheme }} gradient">
    <div id="banner-with-logos-{{ section.id }}" class="banner-with-logos {% if section.settings.custom_class != blank %} {{  section.settings.custom_class }}{% endif %} banner-with-logos--content-align-{{ section.settings.desktop_content_alignment }} banner-with-logos--content-align-mobile-{{ section.settings.mobile_content_alignment }} banner-with-logos--{{ section.settings.image_height }}{% if section.settings.stack_images_on_mobile and section.settings.image != blank and section.settings.image_2 != blank %} banner-with-logos--stacked{% endif %}{% if section.settings.image_height == 'adapt' and section.settings.image != blank %} banner-with-logos--adapt{% endif %}{% if section.settings.show_text_below %} banner-with-logos--mobile-bottom{%- endif -%}{% if section.settings.show_text_box == false %} banner-with-logos--desktop-transparent{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- if section.settings.image != blank -%}
        <div class="desktop-image banner-with-logos__media media{% if section.settings.image == blank and section.settings.image_2 == blank %} placeholder{% endif %}{% if section.settings.image_2 != blank %} banner-with-logos__media-half{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
          {%- liquid
            assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
            if section.settings.image_2 != blank
              assign image_class = 'banner-with-logos__media-image-half'
            endif
            if section.settings.image_2 != blank and section.settings.stack_images_on_mobile
              assign sizes = stacked_sizes
            elsif section.settings.image_2 != blank
              assign sizes = half_width
            else
              assign sizes = full_width
            endif
          -%}
          {{
            section.settings.image
            | image_url: width: 3840
            | image_tag:
              width: section.settings.image.width,
              height: image_height,
              class: image_class,
              sizes: sizes,
              widths: widths,
              fetchpriority: fetch_priority
          }}
        </div>
      {%- elsif section.settings.image_2 == blank -%}
        <div class="banner-with-logos__media media{% if section.settings.image == blank and section.settings.image_2 == blank %} placeholder{% endif %}{% if section.settings.image_2 != blank %} banner-with-logos__media-half{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}

      {%- if section.settings.image_2 != blank -%}
        <div class="desktop-image banner-with-logos__media media{% if section.settings.image_2 != blank %} banner-with-logos__media-half{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
          {%- liquid
            assign image_height_2 = section.settings.image_2.width | divided_by: section.settings.image_2.aspect_ratio
            if section.settings.image != blank
              assign image_class_2 = 'banner-with-logos__media-image-half'
            endif
            if section.settings.image != blank and section.settings.stack_images_on_mobile
              assign sizes = stacked_sizes
            elsif section.settings.image_2 != blank
              assign sizes = half_width
            else
              assign sizes = full_width
            endif
          -%}
          {{
            section.settings.image_2
            | image_url: width: 3840
            | image_tag:
              width: section.settings.image_2.width,
              height: image_height_2,
              class: image_class_2,
              sizes: sizes,
              widths: widths,
              fetchpriority: fetch_priority
          }}
        </div>
      {%- endif -%}
      
      {%- if section.settings.mobile_image != blank -%}
        <div class="mobile-image banner-with-logos__media media {% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
          {%-liquid
            assign image_height_2 = section.settings.mobile_image.width | divided_by: section.settings.mobile_image.aspect_ratio
            if section.settings.image != blank
              assign image_class_2 = "banner-with-logos__media-image-half"
            endif
            if section.settings.image != blank and section.settings.stack_images_on_mobile
              assign sizes = "(min-width: 750px) 50vw, 100vw"
            elsif section.settings.image != blank
              assign sizes = "100vw"
            else
              assign sizes = "100vw"
            endif
          -%}
          {{ section.settings.mobile_image 
            | image_url: width: 1500
            | image_tag:
            width: section.settings.mobile_image.width,
            height: image_height_2,
            class: image_class_2,
            sizes: sizes,
            widths: widths }}
        </div>
      {% else %}
        {% if section.settings.image != blank %}
          <div class="mobile-image banner-with-logos__media media{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
            {%- liquid
              assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
              if section.settings.image_2 != blank
                assign image_class = 'banner-with-logos__media-image-half'
              endif
              if section.settings.image_2 != blank and section.settings.stack_images_on_mobile
                assign sizes = stacked_sizes
              elsif section.settings.image_2 != blank
                assign sizes = half_width
              else
                assign sizes = full_width
              endif
            -%}
            {{
              section.settings.image
              | image_url: width: 1500
              | image_tag:
                width: section.settings.image.width,
                height: image_height,
                class: image_class,
                sizes: sizes,
                widths: widths
            }}
          </div>
        {% else %}
          <div class="banner-with-logos__media media{% if section.settings.image == blank and section.settings.image_2 == blank %} placeholder{% endif %}{% if section.settings.image_2 != blank %} banner-with-logos__media-half{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {% endif %}
      {%- endif -%}

      <div class="banner-with-logos__content banner-with-logos__content--{{ section.settings.desktop_content_position }} page-width">
        <div class="banner-with-logos__box content-container content-container--full-width-mobile color-{{ section.settings.color_scheme }} gradient{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'heading' -%}
                <h2
                  class="banner-with-logos__heading inline-richtext {{ block.settings.heading_size }}"
                  style="--color-heading: {{ block.settings.heading_color }};"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.heading }}
                </h2>
              {%- when 'text' -%}
                <div class="banner-with-logos__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
                  <p>{{ block.settings.text }}</p>
                </div>
              {%- when 'buttons' -%}
                <div
                  class="banner-with-logos__buttons{% if block.settings.button_label_1 != blank and block.settings.button_label_2 != blank %} banner-with-logos__buttons--multiple{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.button_label_1 != blank -%}
                    <a
                      {% if block.settings.button_link_1 == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.button_link_1 }}"
                      {% endif %}
                      class="button{% if block.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %}"
                    >
                      <span>{{- block.settings.button_label_1 | escape -}}</span>
                    </a>
                  {%- endif -%}
                  {%- if block.settings.button_label_2 != blank -%}
                    <a
                      {% if block.settings.button_link_2 == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.button_link_2 }}"
                      {% endif %}
                      class="button second-btn{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
                    >
                      <span>{{- block.settings.button_label_2 | escape -}}</span>
                    </a>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>

        {%- if has_logos > 0 -%}
          <div class="logos--wrap">
            {%- if section.settings.logos_heading -%}
              <div class="logos--title center">
                <h3>{{- section.settings.logos_heading -}}</h3>
              </div>
            {%- endif -%}
            <div class="logos--content">
              <div id="logo-slider-{{ section.id }}" class="logo-slider swiper-container{% comment %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}{% endcomment %}">
                <div class="logo-list swiper-wrapper">
                  {%- for block in section.blocks -%}
                    {%- case block.type -%}
                      {%- when 'logos' -%}
                        {%- if block.settings.image != blank %}
                          <div class="logo logo-list-item swiper-slide" {{ block.shopify_attributes }}>
                            {%- if block.settings.image != blank %}
                              <div class="logo--image logo-list_item">    
                                <img src="{{- block.settings.image | image_url -}}" width="{{- block.settings.image.width -}}" height="{{- block.settings.image.height -}}" alt="{{- block.settings.image.alt -}}" loading="lazy" fetchpriority="auto" />
                              </div> 
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                    {%- endcase -%}
                  {%- endfor -%}
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{%- if has_logos > 0 -%}
  <script type="text/javascript">
    $(function() {
      let SwiperLogos = new Swiper('#logo-slider-{{ section.id }}', {
        spaceBetween: 0,
        centeredSlides: true,
        speed: 3000,
        autoplay: {
          delay: 1,
        },
        loop: true,
        slidesPerView:'auto',
        disableOnInteraction: true,
        allowTouchMove: false,
      });
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.banner-with-logos.name",
  "tag": "section",
  "class": "section section-banner-with-logos",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.all.custom_class.label",
      "info": "t:sections.all.custom_class.info"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.banner-with-logos.settings.image.label"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "t:sections.banner-with-logos.settings.image_2.label"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:sections.banner-with-logos.settings.mobile_image.label"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "t:sections.banner-with-logos.settings.image_overlay_opacity.label",
      "default": 0
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.banner-with-logos.settings.image_height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.banner-with-logos.settings.image_height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.banner-with-logos.settings.image_height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.banner-with-logos.settings.image_height.options__4.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.banner-with-logos.settings.image_height.label"
    },
    {
      "type": "select",
      "id": "image_behavior",
      "options": [
        {
          "value": "none",
          "label": "t:sections.all.animation.image_behavior.options__1.label"
        },
        {
          "value": "ambient",
          "label": "t:sections.all.animation.image_behavior.options__2.label"
        },
        {
          "value": "fixed",
          "label": "t:sections.all.animation.image_behavior.options__3.label"
        },
        {
          "value": "zoom-in",
          "label": "t:sections.all.animation.image_behavior.options__4.label"
        }
      ],
      "default": "none",
      "label": "t:sections.all.animation.image_behavior.label"
    },
    {
      "type": "inline_richtext",
      "id": "logos_heading",
      "default": "t:sections.banner-with-logos.settings.logos_heading.default",
      "label": "t:sections.banner-with-logos.settings.logos_heading.label",
      "info": "t:sections.banner-with-logos.settings.logos_heading.info"
    },
    {
      "type": "header",
      "content": "t:sections.banner-with-logos.settings.content.content"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "top-left",
          "label": "t:sections.banner-with-logos.settings.desktop_content_position.options__1.label"
        },
        {
          "value": "top-center",
          "label": "t:sections.banner-with-logos.settings.desktop_content_position.options__2.label"
        },
        {
          "value": "top-right",
          "label": "t:sections.banner-with-logos.settings.desktop_content_position.options__3.label"
        },
        {
          "value": "middle-left",
          "label": "t:sections.banner-with-logos.settings.desktop_content_position.options__4.label"
        },
        {
          "value": "middle-center",
          "label": "t:sections.banner-with-logos.settings.desktop_content_position.options__5.label"
        },
        {
          "value": "middle-right",
          "label": "t:sections.banner-with-logos.settings.desktop_content_position.options__6.label"
        },
        {
          "value": "bottom-left",
          "label": "t:sections.banner-with-logos.settings.desktop_content_position.options__7.label"
        },
        {
          "value": "bottom-center",
          "label": "t:sections.banner-with-logos.settings.desktop_content_position.options__8.label"
        },
        {
          "value": "bottom-right",
          "label": "t:sections.banner-with-logos.settings.desktop_content_position.options__9.label"
        }
      ],
      "default": "middle-center",
      "label": "t:sections.banner-with-logos.settings.desktop_content_position.label"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.banner-with-logos.settings.desktop_content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.banner-with-logos.settings.desktop_content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.banner-with-logos.settings.desktop_content_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.banner-with-logos.settings.desktop_content_alignment.label"
    },
    {
      "type": "checkbox",
      "id": "show_text_box",
      "default": true,
      "label": "t:sections.banner-with-logos.settings.show_text_box.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.banner-with-logos.settings.mobile.content"
    },
    {
      "type": "checkbox",
      "id": "stack_images_on_mobile",
      "default": true,
      "label": "t:sections.banner-with-logos.settings.stack_images_on_mobile.label"
    },    
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "options": [
        {
          "value": "top-left",
          "label": "t:sections.banner-with-logos.settings.mobile_content_alignment.options__1.label"
        },
        {
          "value": "top-center",
          "label": "t:sections.banner-with-logos.settings.mobile_content_alignment.options__2.label"
        },
        {
          "value": "top-right",
          "label": "t:sections.banner-with-logos.settings.mobile_content_alignment.options__3.label"
        },
        {
          "value": "middle-left",
          "label": "t:sections.banner-with-logos.settings.mobile_content_alignment.options__4.label"
        },
        {
          "value": "middle-center",
          "label": "t:sections.banner-with-logos.settings.mobile_content_alignment.options__5.label"
        },
        {
          "value": "middle-right",
          "label": "t:sections.banner-with-logos.settings.mobile_content_alignment.options__6.label"
        },
        {
          "value": "bottom-left",
          "label": "t:sections.banner-with-logos.settings.mobile_content_alignment.options__7.label"
        },
        {
          "value": "bottom-center",
          "label": "t:sections.banner-with-logos.settings.mobile_content_alignment.options__8.label"
        },
        {
          "value": "bottom-right",
          "label": "t:sections.banner-with-logos.settings.mobile_content_alignment.options__9.label"
        }
      ],
      "default": "middle-center",
      "label": "t:sections.banner-with-logos.settings.mobile_content_alignment.label"
    },
    {
      "type": "checkbox",
      "id": "show_text_below",
      "default": true,
      "label": "t:sections.banner-with-logos.settings.show_text_below.label"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.banner-with-logos.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.banner-with-logos.blocks.heading.settings.heading.default",
          "label": "t:sections.banner-with-logos.blocks.heading.settings.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__2.label"
            },
            {
              "value": "h0",
              "label": "t:sections.all.heading_size.options__3.label"
            },
            {
              "value": "hxl",
              "label": "t:sections.all.heading_size.options__4.label"
            },
            {
              "value": "hxxl",
              "label": "t:sections.all.heading_size.options__5.label"
            }
          ],
          "default": "h1",
          "label": "t:sections.all.heading_size.label"
        },
        {
          "type": "color_background",
          "id": "heading_color",
          "label": "t:sections.banner-with-logos.blocks.heading.settings.heading_color.label",
          "default": "linear-gradient(116deg, #0A4199 0%, #116DFF 49%, #0A4199 100%)"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.banner-with-logos.blocks.text.name",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "t:sections.banner-with-logos.blocks.text.settings.text.default",
          "label": "t:sections.banner-with-logos.blocks.text.settings.text.label"
        },
        {
