{%- liquid
  assign pad_top = section.settings.padding_top
  assign pad_top_vw = pad_top | divided_by: 25.6 | round: 3
  assign pad_top_min = pad_top | times: 0.4 | round

  assign pad_bottom = section.settings.padding_bottom
  assign pad_bottom_vw = pad_bottom | divided_by: 25.6 | round: 3
  assign pad_bottom_min = pad_bottom | times: 0.4 | round

  assign btn_tag = 'span'
  if section.settings.button_link != blank
    assign btn_tag = 'a'
  endif
-%}

{%- style -%}
  .kgc-plan-{{ section.id }} {
    --kgc-bg: {{ section.settings.bg_color }};
    --kgc-color: {{ section.settings.text_color }};
    --kgc-pad-top: clamp({{ pad_top_min }}px, {{ pad_top_vw }}vw, {{ pad_top }}px);
    --kgc-pad-bottom: clamp({{ pad_bottom_min }}px, {{ pad_bottom_vw }}vw, {{ pad_bottom }}px);
  }
{%- endstyle -%}

<div class="kgc-plan kgc-plan-{{ section.id }}" id="kgc-plan">
  <div class="kgc-plan__inner">

    <div class="kgc-plan__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            widths: '400, 600, 800, 1000, 1200, 1600',
            sizes: '(min-width: 750px) 40vw, 100vw',
            loading: 'lazy',
            class: 'kgc-plan__image'
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'kgc-plan__image kgc-plan__placeholder' }}
      {%- endif -%}
    </div>

    <div class="kgc-plan__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="kgc-plan__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading_1 != blank or section.settings.heading_2 != blank -%}
        <h2 class="kgc-plan__heading">
          {%- if section.settings.heading_1 != blank -%}
            <span class="kgc-plan__heading-line">{{ section.settings.heading_1 | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading_2 != blank -%}
            <span class="kgc-plan__heading-line">{{ section.settings.heading_2 | escape }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="kgc-plan__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="kgc-plan__text kgc-plan__text--description">{{ section.settings.description | escape | newline_to_br }}</p>
      {%- endif -%}

      {%- if section.settings.list_title != blank -%}
        <p class="kgc-plan__list-title">{{ section.settings.list_title | escape }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="kgc-plan__list">
          {%- for block in section.blocks -%}
            <li class="kgc-plan__item" {{ block.shopify_attributes }}>
              <span class="kgc-plan__item-number">
                {%- if forloop.index < 10 -%}0{%- endif -%}{{- forloop.index -}}
              </span>
              <span class="kgc-plan__item-text">{{ block.settings.text | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.closing != blank -%}
        <p class="kgc-plan__text kgc-plan__text--closing">{{ section.settings.closing | escape | newline_to_br }}</p>
      {%- endif -%}

      {%- if section.settings.button_text != blank -%}
        <{{ btn_tag }}
          class="kgc-plan__button"
          {% if btn_tag == 'a' %}href="{{ section.settings.button_link }}"{% endif %}
        >
          {{- section.settings.button_text | escape -}}
        </{{ btn_tag }}>
      {%- endif -%}
    </div>

  </div>
</div>

<style>
  .kgc-plan {
    --kgc-accent: #e8001c;
    --kgc-on-accent: #ffffff;
    --kgc-line: color-mix(in srgb, var(--kgc-color) 14%, transparent);
    /* 141px @2560px */
    --kgc-side: clamp(16px, 5.5vw, 141px);
    /* 113px @2560px */
    --kgc-gap: clamp(24px, 4.414vw, 113px);

    box-sizing: border-box;
    width: 100%;
    overflow: hidden;
    background-color: var(--kgc-bg);
    color: var(--kgc-color);
    font-family: 'Montserrat', sans-serif;
    padding-top: var(--kgc-pad-top);
    padding-bottom: var(--kgc-pad-bottom);
    padding-left: var(--kgc-side);
    padding-right: var(--kgc-side);
  }

  .kgc-plan__inner {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--kgc-gap);
    width: 100%;
  }

  /* ---------- Media ---------- */
  .kgc-plan__media {
    width: 100%;
    min-width: 0;
    line-height: 0;
  }

  .kgc-plan__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 354 / 429;
    object-fit: cover;
  }

  .kgc-plan__placeholder {
    background-color: rgba(0, 0, 0, 0.06);
    fill: rgba(0, 0, 0, 0.25);
  }

  /* ---------- Content ---------- */
  .kgc-plan__content {
    min-width: 0;
  }

  .kgc-plan__eyebrow {
    margin: 0;
    color: var(--kgc-accent);
    /* 22px @2560px */
    font-size: clamp(0.625rem, 0.496rem + 0.549vw, 1.375rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .kgc-plan__heading {
    margin: clamp(12px, 2.5vw, 64px) 0 0;
    color: var(--kgc-color);
    font-family: 'Anton', 'Impact', sans-serif;
    font-weight: 400;
    /* 112px @2560px */
    font-size: clamp(2rem, 4.375vw, 7rem);
    line-height: 0.96;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .kgc-plan__heading-line {
    display: block;
  }

  .kgc-plan__subheading {
    margin: clamp(12px, 2.1vw, 54px) 0 0;
    color: var(--kgc-color);
    /* 32px @2560px */
    font-size: clamp(1rem, 0.828rem + 0.732vw, 2rem);
    font-weight: 500;
    line-height: 1.4;
  }

  .kgc-plan__text {
    margin: 0;
    color: var(--kgc-color);
    opacity: 0.7;
    /* 28px @2560px */
    font-size: clamp(0.875rem, 0.725rem + 0.641vw, 1.75rem);
    line-height: 1.55;
  }

  .kgc-plan__text--description {
    margin-top: clamp(10px, 1.9vw, 49px);
  }

  .kgc-plan__text--closing {
    margin-top: clamp(14px, 1.75vw, 45px);
  }

  .kgc-plan__list-title {
    margin: clamp(16px, 1.75vw, 45px) 0 0;
    color: var(--kgc-color);
    /* 20px @2560px */
    font-size: clamp(0.625rem, 0.518rem + 0.458vw, 1.25rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* ---------- List ---------- */
  .kgc-plan__list {
    margin: clamp(6px, 1.2vw, 30px) 0 0;
    padding: 0;
    list-style: none;
  }

  .kgc-plan__item {
    display: flex;
    align-items: baseline;
    padding: clamp(8px, 1.07vw, 27px) 0;
    border-bottom: 1px solid var(--kgc-line);
  }

  .kgc-plan__item-number {
    flex: 0 0 clamp(28px, 3.2vw, 82px);
    color: var(--kgc-accent);
    /* 24px @2560px */
    font-size: clamp(0.6875rem, 0.548rem + 0.595vw, 1.5rem);
    font-weight: 700;
    line-height: 1.4;
  }

  .kgc-plan__item-text {
    min-width: 0;
    color: var(--kgc-color);
    /* 28px @2560px */
    font-size: clamp(0.875rem, 0.725rem + 0.641vw, 1.75rem);
    line-height: 1.4;
  }

  /* ---------- Button (clipped corners) ---------- */
  .kgc-plan__button {
    --kgc-cut: clamp(8px, 1.406vw, 36px);

    display: block;
    box-sizing: border-box;
    width: fit-content;
    max-width: 100%;
    /* 888px @2560px */
    min-width: clamp(220px, 34.7vw, 888px);
    margin-top: clamp(16px, 1.75vw, 45px);
    padding: clamp(12px, 1.6vw, 41px) clamp(16px, 2vw, 51px);
    background-color: var(--kgc-accent);
    color: var(--kgc-on-accent);
    /* 26px @2560px */
    font-size: clamp(0.6875rem, 0.527rem + 0.686vw, 1.625rem);
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    clip-path: polygon(
      0 0,
      calc(100% - var(--kgc-cut)) 0,
      100% var(--kgc-cut),
      100% 100%,
      var(--kgc-cut) 100%,
      0 calc(100% - var(--kgc-cut))
    );
    transition: filter 0.3s ease;
  }

  @media (hover: hover) {
    a.kgc-plan__button:hover {
      filter: brightness(1.15);
    }
  }

  a.kgc-plan__button:focus-visible {
    outline: 2px solid var(--kgc-color);
    outline-offset: 2px;
  }

  /* ---------- Desktop ---------- */
  @media screen and (min-width: 750px) {
    .kgc-plan__inner {
      flex-direction: row;
      align-items: center;
    }

    .kgc-plan__media {
      flex: 0 0 40%;
      width: 40%;
    }

    .kgc-plan__content {
      flex: 1 1 0;
    }
  }
  @media(max-width: 767px){
  .kgc-plan__heading{
    line-height: normal;
  }
  }
</style>

{% schema %}
{
  "name": "KGC Plan Section",
  "tag": "section",
  "class": "kgc-plan-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small top text",
      "default": "The Plan"
    },
    {
      "type": "text",
      "id": "heading_1",
      "label": "Heading line 1",
      "default": "Bring the commitment."
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Heading line 2",
      "default": "We'll bring the plan."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "You don't need to wait for a new year to start working toward your goals."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Homecore is Kris Gethin's 12-week muscle-building Daily Video Trainer, designed to help you train from home or the gym with structure, guidance, and daily motivation."
    },
    {
      "type": "text",
      "id": "list_title",
      "label": "List title",
      "default": "Inside the program"
    },
    {
      "type": "textarea",
      "id": "closing",
      "label": "Text below list",
      "default": "The challenge gives you a start date, a goal to work toward, and an opportunity to win a prize package that supports your next chapter."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "I'm ready to start"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Content color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "#f6f6f4"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 160
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 160
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "List item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "List item text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KGC Plan Section",
      "blocks": [
        {
          "type": "item",
          "settings": { "text": "Structured workouts you can follow from home or the gym" }
        },
        {
          "type": "item",
          "settings": { "text": "Nutrition and supplementation guidance" }
        },
        {
          "type": "item",
          "settings": { "text": "Daily videos from Kris to keep you focused" }
        },
        {
          "type": "item",
          "settings": { "text": "A private community to share progress and stay accountable" }
        }
      ]
    }
  ]
}
{% endschema %}