{%- liquid
  assign pad_top = section.settings.padding_top
  assign pad_top_vw = pad_top | divided_by: 25.6 | round: 3
  assign pad_top_min = pad_top | times: 0.4 | round

  assign pad_bottom = section.settings.padding_bottom
  assign pad_bottom_vw = pad_bottom | divided_by: 25.6 | round: 3
  assign pad_bottom_min = pad_bottom | times: 0.4 | round

  assign btn_tag = 'span'
  if section.settings.button_link != blank
    assign btn_tag = 'a'
  endif
-%}

{%- style -%}
  .kgc-cta-{{ section.id }} {
    --kgc-bg: {{ section.settings.bg_color }};
    --kgc-color: {{ section.settings.text_color }};
    --kgc-btn-bg: {{ section.settings.button_bg }};
    --kgc-btn-color: {{ section.settings.button_color }};
    --kgc-pad-top: clamp({{ pad_top_min }}px, {{ pad_top_vw }}vw, {{ pad_top }}px);
    --kgc-pad-bottom: clamp({{ pad_bottom_min }}px, {{ pad_bottom_vw }}vw, {{ pad_bottom }}px);
  }
{%- endstyle -%}

<div class="kgc-cta kgc-cta-{{ section.id }}">
  <div class="kgc-cta__inner">

    <div class="kgc-cta__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="kgc-cta__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading_1 != blank or section.settings.heading_2 != blank -%}
        <h2 class="kgc-cta__heading">
          {%- if section.settings.heading_1 != blank -%}
            <span class="kgc-cta__heading-line">{{ section.settings.heading_1 | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading_2 != blank -%}
            <span class="kgc-cta__heading-line">{{ section.settings.heading_2 | escape }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}
    </div>

    <div class="kgc-cta__body">
      {%- if section.settings.text != blank -%}
        <p class="kgc-cta__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      {%- if section.settings.highlight != blank -%}
        <p class="kgc-cta__highlight">{{ section.settings.highlight | escape }}</p>
      {%- endif -%}

      {%- if section.settings.button_text != blank -%}
        <{{ btn_tag }}
          class="kgc-cta__button"
          {% if btn_tag == 'a' %}href="{{ section.settings.button_link }}"{% endif %}
        >
          {{- section.settings.button_text | escape -}}
        </{{ btn_tag }}>
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <p class="kgc-cta__note">{{ section.settings.note | escape }}</p>
      {%- endif -%}
    </div>

  </div>
</div>

<style>
  .kgc-cta {
    /* 141px @2560px */
    --kgc-side: clamp(16px, 5.5vw, 141px);

    box-sizing: border-box;
    width: 100%;
    overflow: hidden;
    background-color: var(--kgc-bg);
    color: var(--kgc-color);
    font-family: 'Montserrat', sans-serif;
    padding-top: var(--kgc-pad-top);
    padding-bottom: var(--kgc-pad-bottom);
    padding-left: var(--kgc-side);
    padding-right: var(--kgc-side);
  }

  .kgc-cta__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3vw, 77px);
    width: 100%;
  }

  /* ---------- Head ---------- */
  .kgc-cta__head {
    min-width: 0;
  }

  .kgc-cta__eyebrow {
    margin: 0;
    color: var(--kgc-color);
    /* 22px @2560px */
    font-size: clamp(0.625rem, 0.496rem + 0.549vw, 1.375rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .kgc-cta__heading {
    margin: clamp(8px, 1.1vw, 28px) 0 0;
    color: var(--kgc-color);
    font-family: 'Anton', 'Impact', sans-serif;
    font-weight: 400;
    /* 118px @2560px */
    font-size: clamp(2.5rem, 4.6vw, 7.375rem);
    line-height: 0.96;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .kgc-cta__heading-line {
    display: block;
  }

  /* ---------- Body ---------- */
  .kgc-cta__body {
    min-width: 0;
  }

  .kgc-cta__text {
    margin: 0;
    color: var(--kgc-color);
    /* 32px @2560px */
    font-size: clamp(0.875rem, 0.735rem + 0.595vw, 2rem);
    font-weight: 400;
    line-height: 1.5;
  }

  .kgc-cta__highlight {
    margin: clamp(10px, 1.7vw, 44px) 0 0;
    color: var(--kgc-color);
    /* 40px @2560px */
    font-size: clamp(1rem, 0.8rem + 0.85vw, 2.5rem);
    font-weight: 700;
    line-height: 1.3;
  }

  /* ---------- Button (clipped corners) ---------- */
  .kgc-cta__button {
    --kgc-cut: clamp(8px, 1.406vw, 36px);

    display: block;
    box-sizing: border-box;
    width: fit-content;
    max-width: 100%;
    /* 901px @2560px */
    min-width: clamp(220px, 35.2vw, 901px);
    margin-top: clamp(14px, 1.7vw, 44px);
    padding: clamp(12px, 1.6vw, 41px) clamp(16px, 2vw, 51px);
    background-color: var(--kgc-btn-bg);
    color: var(--kgc-btn-color);
    /* 26px @2560px */
    font-size: clamp(0.6875rem, 0.527rem + 0.686vw, 1.625rem);
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    clip-path: polygon(
      0 0,
      calc(100% - var(--kgc-cut)) 0,
      100% var(--kgc-cut),
      100% 100%,
      var(--kgc-cut) 100%,
      0 calc(100% - var(--kgc-cut))
    );
    transition: filter 0.3s ease;
  }

  @media (hover: hover) {
    a.kgc-cta__button:hover {
      filter: brightness(1.4);
    }
  }

  a.kgc-cta__button:focus-visible {
    outline: 2px solid var(--kgc-color);
    outline-offset: 2px;
  }

  .kgc-cta__note {
    margin: clamp(10px, 1.5vw, 38px) 0 0;
    color: var(--kgc-color);
    /* 22px @2560px */
    font-size: clamp(0.625rem, 0.496rem + 0.549vw, 1.375rem);
    line-height: 1.4;
  }

  /* ---------- Desktop ---------- */
  @media screen and (min-width: 750px) {
    .kgc-cta__inner {
      flex-direction: row;
      align-items: center;
    }

    .kgc-cta__head {
      flex: 1 1 0;
    }

    .kgc-cta__body {
      flex: 0 0 47.3%;
      width: 47.3%;
    }
  }
</style>

{% schema %}
{
  "name": "KGC CTA Section",
  "tag": "section",
  "class": "kgc-cta-section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small top text",
      "default": "Starts 19 October 2026"
    },
    {
      "type": "text",
      "id": "heading_1",
      "label": "Heading line 1",
      "default": "Give yourself a"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Heading line 2",
      "default": "reason to start now."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A plan you can follow from home or the gym. Daily guidance from Kris. A community working toward change alongside you."
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Bold text",
      "default": "Your next chapter starts October 19."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small note",
      "default": "Free challenge entry with membership. More prizes are coming soon."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Join Gethinverse & enter the challenge"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Content color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "#ed0019"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 208
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 208
    }
  ],
  "presets": [
    {
      "name": "KGC CTA Section"
    }
  ]
}
{% endschema %}
