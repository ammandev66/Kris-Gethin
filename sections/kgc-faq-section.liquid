{%- liquid
  assign pad_top = section.settings.padding_top
  assign pad_top_vw = pad_top | divided_by: 25.6 | round: 3
  assign pad_top_min = pad_top | times: 0.4 | round

  assign pad_bottom = section.settings.padding_bottom
  assign pad_bottom_vw = pad_bottom | divided_by: 25.6 | round: 3
  assign pad_bottom_min = pad_bottom | times: 0.4 | round
-%}

{%- style -%}
  .kgc-faq-{{ section.id }} {
    --kgc-bg: {{ section.settings.bg_color }};
    --kgc-color: {{ section.settings.text_color }};
    --kgc-pad-top: clamp({{ pad_top_min }}px, {{ pad_top_vw }}vw, {{ pad_top }}px);
    --kgc-pad-bottom: clamp({{ pad_bottom_min }}px, {{ pad_bottom_vw }}vw, {{ pad_bottom }}px);
  }
{%- endstyle -%}

<div class="kgc-faq kgc-faq-{{ section.id }}" id="kgc-faq">
  <div class="kgc-faq__inner">

    <div class="kgc-faq__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="kgc-faq__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading_1 != blank or section.settings.heading_2 != blank -%}
        <h2 class="kgc-faq__heading">
          {%- if section.settings.heading_1 != blank -%}
            <span class="kgc-faq__heading-line">{{ section.settings.heading_1 | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading_2 != blank -%}
            <span class="kgc-faq__heading-line">{{ section.settings.heading_2 | escape }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}
    </div>

    <div class="kgc-faq__body">
      {%- if section.blocks.size > 0 -%}
        <ul class="kgc-faq__list">
          {%- for block in section.blocks -%}
            <li class="kgc-faq__item" {{ block.shopify_attributes }}>
              {%- if block.settings.question != blank -%}
                <p class="kgc-faq__question">{{ block.settings.question | escape }}</p>
              {%- endif -%}
              {%- if block.settings.answer != blank -%}
                <p class="kgc-faq__answer">{{ block.settings.answer | escape }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

  </div>
</div>

<style>
  .kgc-faq {
    --kgc-accent: #e8001c;
    --kgc-line: color-mix(in srgb, var(--kgc-color) 14%, transparent);
    /* 141px @2560px */
    --kgc-side: clamp(16px, 5.5vw, 141px);

    box-sizing: border-box;
    width: 100%;
    overflow: hidden;
    background-color: var(--kgc-bg);
    color: var(--kgc-color);
    font-family: 'Montserrat', sans-serif;
    padding-top: var(--kgc-pad-top);
    padding-bottom: var(--kgc-pad-bottom);
    padding-left: var(--kgc-side);
    padding-right: var(--kgc-side);
  }

  .kgc-faq__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3vw, 77px);
    width: 100%;
  }

  /* ---------- Head ---------- */
  .kgc-faq__head {
    min-width: 0;
  }

  .kgc-faq__eyebrow {
    margin: 0;
    color: var(--kgc-accent);
    /* 22px @2560px */
    font-size: clamp(0.625rem, 0.496rem + 0.549vw, 1.375rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .kgc-faq__heading {
    margin: clamp(8px, 1.5vw, 38px) 0 0;
    color: var(--kgc-color);
    font-family: 'Anton', 'Impact', sans-serif;
    font-weight: 400;
    /* 118px @2560px */
    font-size: clamp(2.5rem, 4.6vw, 7.375rem);
    line-height: 0.96;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .kgc-faq__heading-line {
    display: block;
  }

  /* ---------- Body ---------- */
  .kgc-faq__body {
    min-width: 0;
  }

  .kgc-faq__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kgc-faq__item {
    padding: clamp(10px, 1.84vw, 47px) 0;
    border-bottom: 1px solid var(--kgc-line);
  }

  .kgc-faq__item:first-child {
    padding-top: 0;
  }

  .kgc-faq__question {
    margin: 0;
    color: var(--kgc-color);
    /* 36px @2560px */
    font-size: clamp(1rem, 0.786rem + 0.915vw, 2.25rem);
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .kgc-faq__answer {
    margin: clamp(3px, 0.68vw, 17px) 0 0;
    color: var(--kgc-color);
    opacity: 0.7;
    /* 26px @2560px */
    font-size: clamp(0.8125rem, 0.673rem + 0.595vw, 1.625rem);
    line-height: 1.6;
  }

  /* ---------- Desktop ---------- */
  @media screen and (min-width: 750px) {
    .kgc-faq__inner {
      flex-direction: row;
      align-items: flex-start;
    }

    .kgc-faq__head {
      flex: 1 1 0;
    }

    .kgc-faq__body {
      flex: 0 0 62.3%;
      width: 62.3%;
    }
  }
</style>

{% schema %}
{
  "name": "KGC FAQ Section",
  "tag": "section",
  "class": "kgc-faq-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small top text",
      "default": "Before you begin"
    },
    {
      "type": "text",
      "id": "heading_1",
      "label": "Heading line 1",
      "default": "Frequently"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Heading line 2",
      "default": "Asked Questions"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Content color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 156
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 148
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KGC FAQ Section",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "When does the challenge start?",
            "answer": "The Homecore Challenge starts Monday October 19, 2026."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How much does it cost to enter?",
            "answer": "Entry is free with a Gethinverse membership. Membership fees apply; there is no additional challenge entry fee."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I do Homecore from home or the gym?",
            "answer": "Either. Homecore gives you the flexibility to train from home or the gym. Review the program's equipment requirements before you begin."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What can I win?",
            "answer": "The best transformation wins six months of VIP coaching with Kris Gethin, supplement stacks from Unmatched Supps and BioStack Labs, a GASP / Better Bodies gift card, a free box of food from Nutrition Solutions, and additional prizes to be announced."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I submit a before video instead of photos?",
            "answer": "Yes. You can document your starting point with before photos or a before video. Use the same format for your after submission to clearly show your transformation."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Do I need to submit before and after content to win?",
            "answer": "Yes. Before and after photos or videos are required to be considered for the best transformation prize. Make sure you follow the instructions provided."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Will my photos or videos be used for marketing?",
            "answer": "To be eligible to win, you must allow your submitted before and after photos or videos to be used for marketing. Review the full consent details when registering."
          }
        }
      ]
    }
  ]
}
{% endschema %}
