{%- liquid
  assign pad_top = section.settings.padding_top
  assign pad_top_vw = pad_top | divided_by: 25.6 | round: 3
  assign pad_top_min = pad_top | times: 0.4 | round

  assign pad_bottom = section.settings.padding_bottom
  assign pad_bottom_vw = pad_bottom | divided_by: 25.6 | round: 3
  assign pad_bottom_min = pad_bottom | times: 0.4 | round

  assign logo_w = section.settings.logo_width
  assign logo_w_vw = logo_w | divided_by: 25.6 | round: 3
  assign logo_w_min = logo_w | times: 0.4 | round

  assign current_year = 'now' | date: '%Y'
  assign copyright = section.settings.copyright | replace: '{year}', current_year

  assign footer_menu = linklists[section.settings.menu]
-%}

{%- style -%}
  .kgc-footer-{{ section.id }} {
    --kgc-bg: {{ section.settings.bg_color }};
    --kgc-color: {{ section.settings.text_color }};
    --kgc-logo-w: clamp({{ logo_w_min }}px, {{ logo_w_vw }}vw, {{ logo_w }}px);
    --kgc-pad-top: clamp({{ pad_top_min }}px, {{ pad_top_vw }}vw, {{ pad_top }}px);
    --kgc-pad-bottom: clamp({{ pad_bottom_min }}px, {{ pad_bottom_vw }}vw, {{ pad_bottom }}px);
  }
{%- endstyle -%}

<div class="kgc-footer kgc-footer-{{ section.id }}">
  <div class="kgc-footer__top">

    <div class="kgc-footer__brand">
      <a class="kgc-footer__logo-link" href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 1000
            | image_tag:
              class: 'kgc-footer__logo',
              loading: 'lazy',
              widths: '300, 500, 800, 1000',
              sizes: '(min-width: 750px) 18vw, 50vw',
              alt: section.settings.logo.alt | default: shop.name
          }}
        {%- else -%}
          <span class="kgc-footer__logo-text">{{ section.settings.logo_text | escape }}</span>
        {%- endif -%}
      </a>
    </div>

    {%- if footer_menu != blank and footer_menu.links.size > 0 -%}
      <nav class="kgc-footer__nav" aria-label="{{ footer_menu.title | escape }}">
        <ul class="kgc-footer__menu">
          {%- for link in footer_menu.links -%}
            <li class="kgc-footer__menu-item">
              <a
                class="kgc-footer__link"
                href="{{ link.url }}"
                {% if link.current %}aria-current="page"{% endif %}
              >
                {{- link.title | escape -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

  </div>

  {%- if copyright != blank -%}
    <div class="kgc-footer__bottom">
      <p class="kgc-footer__copyright">{{ copyright | escape }}</p>
    </div>
  {%- endif -%}
</div>

<style>
  .kgc-footer {
    --kgc-line: color-mix(in srgb, var(--kgc-color) 14%, transparent);
    /* 141px @2560px */
    --kgc-side: clamp(16px, 5.5vw, 141px);
    /* 35px @2560px */
    --kgc-menu-gap: clamp(12px, 1.37vw, 35px);

    box-sizing: border-box;
    width: 100%;
    overflow: hidden;
    background-color: var(--kgc-bg);
    color: var(--kgc-color);
    font-family: 'Montserrat', sans-serif;
    padding-top: var(--kgc-pad-top);
    padding-bottom: var(--kgc-pad-bottom);
    padding-left: var(--kgc-side);
    padding-right: var(--kgc-side);
  }

  /* ---------- Top row ---------- */
  .kgc-footer__top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(20px, 2.5vw, 64px);
    padding-bottom: clamp(16px, 1.9vw, 48px);
    border-bottom: 1px solid var(--kgc-line);
  }

  .kgc-footer__brand {
    min-width: 0;
  }

  .kgc-footer__logo-link {
    display: block;
    width: fit-content;
    color: var(--kgc-color);
    text-decoration: none;
  }

  .kgc-footer__logo {
    display: block;
    width: var(--kgc-logo-w);
    max-width: 100%;
    height: auto;
  }

  .kgc-footer__logo-text {
    display: block;
    font-family: 'Anton', 'Impact', sans-serif;
    /* 70px @2560px */
    font-size: clamp(1.75rem, 2.734vw, 4.375rem);
    line-height: 1;
    text-transform: uppercase;
  }

  /* ---------- Menu ---------- */
  .kgc-footer__nav {
    min-width: 0;
  }

  .kgc-footer__menu {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px var(--kgc-menu-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kgc-footer__menu-item {
    display: flex;
    align-items: center;
    gap: var(--kgc-menu-gap);
  }

  /* dot separator between items */
  .kgc-footer__menu-item + .kgc-footer__menu-item::before {
    content: '';
    flex: 0 0 auto;
    width: clamp(3px, 0.26vw, 7px);
    height: clamp(3px, 0.26vw, 7px);
    border-radius: 50%;
    background-color: var(--kgc-color);
    opacity: 0.7;
  }

  .kgc-footer__link {
    color: var(--kgc-color);
    opacity: 0.7;
    /* 22px @2560px */
    font-size: clamp(0.6875rem, 0.55rem + 0.5vw, 1.375rem);
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.3s ease;
  }

  @media (hover: hover) {
    .kgc-footer__link:hover {
      opacity: 1;
    }
  }

  .kgc-footer__link:focus-visible {
    opacity: 1;
    outline: 2px solid var(--kgc-color);
    outline-offset: 4px;
  }

  .kgc-footer__link[aria-current='page'] {
    opacity: 1;
  }

  /* ---------- Copyright ---------- */
  .kgc-footer__bottom {
    margin-top: clamp(12px, 1.8vw, 46px);
  }

  .kgc-footer__copyright {
    margin: 0;
    color: var(--kgc-color);
    opacity: 0.6;
    /* 20px @2560px */
    font-size: clamp(0.6875rem, 0.6rem + 0.35vw, 1.25rem);
    line-height: 1.5;
  }

  /* ---------- Desktop ---------- */
  @media screen and (min-width: 750px) {
    .kgc-footer__top {
      flex-direction: row;
      align-items: center;
      gap: 0;
    }

    /* menu starts at ~43% of the row (matches the design) */
    .kgc-footer__brand {
      flex: 0 0 42.8%;
      width: 42.8%;
    }

    .kgc-footer__nav {
      flex: 1 1 0;
    }
  }
</style>

{% schema %}
{
  "name": "KGC Footer",
  "tag": "footer",
  "class": "kgc-footer-section",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Fallback text (shown if no logo image)",
      "default": "Kris Gethin"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 120,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 450,
      "info": "Size at 2560px screen width. It scales down on smaller screens."
    },
    {
      "type": "header",
      "content": "Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright text",
      "default": "© {year} Kris Gethin Coaching. All rights reserved.",
      "info": "{year} is replaced with the current year automatically."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Content color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "#0a0a0a"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "KGC Footer"
    }
  ]
}
{% endschema %}
