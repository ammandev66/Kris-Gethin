{%- liquid
  assign pad_top = section.settings.padding_top
  assign pad_top_vw = pad_top | divided_by: 25.6 | round: 3
  assign pad_top_min = pad_top | times: 0.4 | round

  assign pad_bottom = section.settings.padding_bottom
  assign pad_bottom_vw = pad_bottom | divided_by: 25.6 | round: 3
  assign pad_bottom_min = pad_bottom | times: 0.4 | round

  assign btn_tag = 'span'
  if section.settings.button_link != blank
    assign btn_tag = 'a'
  endif
-%}

{%- style -%}
  .kgc-steps-{{ section.id }} {
    --kgc-bg: {{ section.settings.bg_color }};
    --kgc-color: {{ section.settings.text_color }};
    --kgc-pad-top: clamp({{ pad_top_min }}px, {{ pad_top_vw }}vw, {{ pad_top }}px);
    --kgc-pad-bottom: clamp({{ pad_bottom_min }}px, {{ pad_bottom_vw }}vw, {{ pad_bottom }}px);
  }
{%- endstyle -%}

<div class="kgc-steps kgc-steps-{{ section.id }}" id="kgc-steps">
  <div class="kgc-steps__inner">

    <div class="kgc-steps__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="kgc-steps__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading_1 != blank or section.settings.heading_2 != blank -%}
        <h2 class="kgc-steps__heading">
          {%- if section.settings.heading_1 != blank -%}
            <span class="kgc-steps__heading-line">{{ section.settings.heading_1 | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading_2 != blank -%}
            <span class="kgc-steps__heading-line">{{ section.settings.heading_2 | escape }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}
    </div>

    <div class="kgc-steps__body">
      {%- if section.blocks.size > 0 -%}
        <ol class="kgc-steps__list">
          {%- for block in section.blocks -%}
            <li class="kgc-steps__item" {{ block.shopify_attributes }}>
              <span class="kgc-steps__number">
                {%- if forloop.index < 10 -%}0{%- endif -%}{{- forloop.index -}}
              </span>
              <div class="kgc-steps__item-content">
                {%- if block.settings.title != blank -%}
                  <p class="kgc-steps__item-title">{{ block.settings.title | escape }}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="kgc-steps__item-text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {%- if section.settings.note_title != blank or section.settings.note_text != blank -%}
        <div class="kgc-steps__note">
          {%- if section.settings.note_title != blank -%}
            <p class="kgc-steps__note-title">{{ section.settings.note_title | escape }}</p>
          {%- endif -%}
          {%- if section.settings.note_text != blank -%}
            <p class="kgc-steps__note-text">{{ section.settings.note_text | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.button_text != blank -%}
        <{{ btn_tag }}
          class="kgc-steps__button"
          {% if btn_tag == 'a' %}href="{{ section.settings.button_link }}"{% endif %}
        >
          {{- section.settings.button_text | escape -}}
        </{{ btn_tag }}>
      {%- endif -%}
    </div>

  </div>
</div>

<style>
  .kgc-steps {
    --kgc-accent: #e8001c;
    --kgc-on-accent: #ffffff;
    --kgc-line: color-mix(in srgb, var(--kgc-color) 14%, transparent);
    /* 141px @2560px */
    --kgc-side: clamp(16px, 5.5vw, 141px);

    box-sizing: border-box;
    width: 100%;
    overflow: hidden;
    background-color: var(--kgc-bg);
    color: var(--kgc-color);
    font-family: 'Montserrat', sans-serif;
    padding-top: var(--kgc-pad-top);
    padding-bottom: var(--kgc-pad-bottom);
    padding-left: var(--kgc-side);
    padding-right: var(--kgc-side);
  }

  .kgc-steps__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3vw, 77px);
    width: 100%;
  }

  /* ---------- Head ---------- */
  .kgc-steps__head {
    min-width: 0;
  }

  .kgc-steps__eyebrow {
    margin: 0;
    color: var(--kgc-accent);
    /* 22px @2560px */
    font-size: clamp(0.625rem, 0.496rem + 0.549vw, 1.375rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .kgc-steps__heading {
    margin: clamp(8px, 1.5vw, 38px) 0 0;
    color: var(--kgc-color);
    font-family: 'Anton', 'Impact', sans-serif;
    font-weight: 400;
    /* 158px @2560px */
    font-size: clamp(3rem, 6.172vw, 9.875rem);
    line-height: 0.96;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .kgc-steps__heading-line {
    display: block;
  }

  /* ---------- Body ---------- */
  .kgc-steps__body {
    min-width: 0;
  }

  .kgc-steps__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kgc-steps__item {
    display: flex;
    align-items: flex-start;
    padding: clamp(10px, 1.84vw, 47px) 0;
    border-bottom: 1px solid var(--kgc-line);
  }

  .kgc-steps__number {
    /* 149px @2560px */
    flex: 0 0 clamp(44px, 5.82vw, 149px);
    color: var(--kgc-accent);
    font-family: 'Anton', 'Impact', sans-serif;
    font-weight: 400;
    /* 90px @2560px */
    font-size: clamp(2rem, 3.516vw, 5.625rem);
    line-height: 1;
  }

  .kgc-steps__item-content {
    flex: 1 1 0;
    min-width: 0;
  }

  .kgc-steps__item-title {
    margin: 0;
    color: var(--kgc-color);
    /* 36px @2560px */
    font-size: clamp(1rem, 0.786rem + 0.915vw, 2.25rem);
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .kgc-steps__item-text {
    margin: clamp(3px, 0.68vw, 17px) 0 0;
    color: var(--kgc-color);
    opacity: 0.7;
    /* 26px @2560px */
    font-size: clamp(0.8125rem, 0.673rem + 0.595vw, 1.625rem);
    line-height: 1.6;
  }

  /* ---------- Note box ---------- */
  .kgc-steps__note {
    box-sizing: border-box;
    margin-top: clamp(12px, 1.9vw, 49px);
    padding: clamp(10px, 1.64vw, 42px) clamp(12px, 1.52vw, 39px);
    border: 1px solid var(--kgc-line);
  }

  .kgc-steps__note-title {
    margin: 0;
    color: var(--kgc-color);
    /* 22px @2560px */
    font-size: clamp(0.625rem, 0.496rem + 0.549vw, 1.375rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .kgc-steps__note-text {
    margin: clamp(4px, 0.5vw, 13px) 0 0;
    color: var(--kgc-color);
    opacity: 0.7;
    /* 24px @2560px */
    font-size: clamp(0.75rem, 0.621rem + 0.549vw, 1.5rem);
    line-height: 1.5;
  }

  /* ---------- Button (clipped corners) ---------- */
  .kgc-steps__button {
    --kgc-cut: clamp(8px, 1.406vw, 36px);

    display: block;
    box-sizing: border-box;
    width: fit-content;
    max-width: 100%;
    /* 901px @2560px */
    min-width: clamp(220px, 35.2vw, 901px);
    margin-top: clamp(14px, 1.64vw, 42px);
    padding: clamp(12px, 1.6vw, 41px) clamp(16px, 2vw, 51px);
    background-color: var(--kgc-accent);
    color: var(--kgc-on-accent);
    /* 26px @2560px */
    font-size: clamp(0.6875rem, 0.527rem + 0.686vw, 1.625rem);
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    clip-path: polygon(
      0 0,
      calc(100% - var(--kgc-cut)) 0,
      100% var(--kgc-cut),
      100% 100%,
      var(--kgc-cut) 100%,
      0 calc(100% - var(--kgc-cut))
    );
    transition: filter 0.3s ease;
  }

  @media (hover: hover) {
    a.kgc-steps__button:hover {
      filter: brightness(1.15);
    }
  }

  a.kgc-steps__button:focus-visible {
    outline: 2px solid var(--kgc-color);
    outline-offset: 2px;
  }

  /* ---------- Desktop ---------- */
  @media screen and (min-width: 750px) {
    .kgc-steps__inner {
      flex-direction: row;
      align-items: flex-start;
    }

    .kgc-steps__head {
      flex: 1 1 0;
    }

    .kgc-steps__body {
      flex: 0 0 62.3%;
      width: 62.3%;
    }
  }
</style>

{% schema %}
{
  "name": "KGC Steps Section",
  "tag": "section",
  "class": "kgc-steps-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small top text",
      "default": "Your Next Move"
    },
    {
      "type": "text",
      "id": "heading_1",
      "label": "Heading line 1",
      "default": "How to"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Heading line 2",
      "default": "Take part"
    },
    {
      "type": "header",
      "content": "Note box"
    },
    {
      "type": "text",
      "id": "note_title",
      "label": "Title",
      "default": "Marketing permission"
    },
    {
      "type": "textarea",
      "id": "note_text",
      "label": "Text",
      "default": "To be eligible to win, you must give permission for your submitted before and after photos or videos to be used for marketing."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Join the Homecore challenge"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Content color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "#f6f6f4"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 156
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 148
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KGC Steps Section",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Join Gethinverse",
            "text": "Challenge entry is included with your membership at no additional cost."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Register for the challenge",
            "text": "Enter the Homecore Challenge and get ready to start on October 19."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Document your starting point",
            "text": "Take before photos or record a before video to capture your starting point. Keep documenting your progress so you can see how far you've come."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Follow the Homecore trainer",
            "text": "Train from home or the gym using the workouts, guidance, and daily videos to build a routine you can stick with."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Submit your transformation",
            "text": "Submit your before and after photos (or videos) as directed to be considered for the prize package. Use the same format for your before and after submissions so your progress can be compared clearly."
          }
        }
      ]
    }
  ]
}
{% endschema %}