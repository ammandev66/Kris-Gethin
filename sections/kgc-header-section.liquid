{%- liquid
  assign pad_top = section.settings.padding_top
  assign pad_top_vw = pad_top | divided_by: 25.6 | round: 3
  assign pad_top_min = pad_top | times: 0.4 | round

  assign pad_bottom = section.settings.padding_bottom
  assign pad_bottom_vw = pad_bottom | divided_by: 25.6 | round: 3
  assign pad_bottom_min = pad_bottom | times: 0.4 | round

  assign logo_w = section.settings.logo_width
  assign logo_w_vw = logo_w | divided_by: 25.6 | round: 3
  assign logo_w_min = logo_w | times: 0.4 | round

  assign header_menu = linklists[section.settings.menu]

  assign login_url = section.settings.login_link
  assign login_label = section.settings.login_text
  if customer
    assign login_url = routes.account_url
    assign login_label = section.settings.account_text
  elsif login_url == blank
    assign login_url = routes.account_login_url
  endif

  assign has_announcement = false
  if section.settings.show_announcement and section.blocks.size > 0
    assign has_announcement = true
  endif
-%}

{%- style -%}
  .kgc-header-{{ section.id }} {
    --kgc-bg: {{ section.settings.bg_color }};
    --kgc-color: {{ section.settings.text_color }};
    --kgc-ann-bg: {{ section.settings.announcement_bg }};
    --kgc-ann-color: {{ section.settings.announcement_color }};
    --kgc-logo-w: clamp({{ logo_w_min }}px, {{ logo_w_vw }}vw, {{ logo_w }}px);
    --kgc-pad-top: clamp({{ pad_top_min }}px, {{ pad_top_vw }}vw, {{ pad_top }}px);
    --kgc-pad-bottom: clamp({{ pad_bottom_min }}px, {{ pad_bottom_vw }}vw, {{ pad_bottom }}px);
  }
{%- endstyle -%}

<kgc-header
  class="kgc-header kgc-header-{{ section.id }}"
  data-sticky="{{ section.settings.sticky_type }}"
  data-ann-scroll="{{ section.settings.announcement_scrolls }}"
>

  {%- if has_announcement -%}
    <div class="kgc-header__announcement" role="region" aria-label="Announcement">
      <div class="kgc-header__ann-inner">
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            <div class="kgc-header__ann-item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a class="kgc-header__ann-text" href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
              {%- else -%}
                <p class="kgc-header__ann-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <div class="kgc-header__main">
    <div class="kgc-header__row">

      <div class="kgc-header__brand">
        <a class="kgc-header__logo-link" href="{{ routes.root_url }}">
          {%- if section.settings.logo != blank -%}
            {{
              section.settings.logo
              | image_url: width: 1000
              | image_tag:
                class: 'kgc-header__logo',
                loading: 'eager',
                widths: '300, 500, 800, 1000',
                sizes: '(min-width: 990px) 18vw, 50vw',
                alt: section.settings.logo.alt | default: shop.name
            }}
          {%- else -%}
            <span class="kgc-header__logo-text">{{ section.settings.logo_text | escape }}</span>
          {%- endif -%}
        </a>
      </div>

      <button
        type="button"
        class="kgc-header__toggle"
        aria-expanded="false"
        aria-controls="kgc-panel-{{ section.id }}"
      >
        <span class="kgc-header__sr">Menu</span>
        <span class="kgc-header__bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>

      <div class="kgc-header__panel" id="kgc-panel-{{ section.id }}">
        {%- if header_menu != blank and header_menu.links.size > 0 -%}
          <nav class="kgc-header__nav" aria-label="{{ header_menu.title | escape }}">
            <ul class="kgc-header__menu">
              {%- for link in header_menu.links -%}
                <li class="kgc-header__menu-item">
                  <a
                    class="kgc-header__link"
                    href="{{ link.url }}"
                    {% if link.current %}aria-current="page"{% endif %}
                  >
                    {{- link.title | escape -}}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        {%- if section.settings.show_login and login_label != blank -%}
          <a class="kgc-header__login" href="{{ login_url }}">{{ login_label | escape }}</a>
        {%- endif -%}
      </div>

    </div>
  </div>
</kgc-header>

<style>
  /* ---------- Section wrapper ---------- */
  .kgc-header-section {
    position: relative;
    z-index: 100;
    margin: 0;
  }

  /* Sticky (wrapper is a direct child of <body>, like Dawn's header group) */
  .kgc-header-section:has(.kgc-header[data-sticky='always']),
  .kgc-header-section:has(.kgc-header[data-sticky='on-scroll-up']) {
    position: sticky;
    top: 0;
  }

  /* Announcement bar scrolls away, header stays */
  .kgc-header-section:has(.kgc-header[data-sticky='always'][data-ann-scroll='true']),
  .kgc-header-section:has(.kgc-header[data-sticky='on-scroll-up'][data-ann-scroll='true']) {
    top: calc(-1 * var(--kgc-ann-h, 0px));
  }

  .kgc-header-section:has(.kgc-header[data-sticky='on-scroll-up']) {
    transition: transform 0.3s ease;
  }

  .kgc-header-section.kgc-header--hidden {
    transform: translateY(-100%);
  }

  html {
    scroll-padding-top: var(--kgc-header-height, 0px);
  }

  /* ---------- Header ---------- */
  .kgc-header {
    --kgc-line: color-mix(in srgb, var(--kgc-color) 12%, transparent);
    /* 141px @2560px */
    --kgc-side: clamp(16px, 5.5vw, 141px);
    /* 114px @2560px */
    --kgc-nav-gap: clamp(16px, 4.4vw, 114px);

    display: block;
    width: 100%;
    font-family: 'Montserrat', sans-serif;
  }

  /* ---------- Announcement bar ---------- */
  .kgc-header__announcement {
    box-sizing: border-box;
    background-color: var(--kgc-ann-bg);
    color: var(--kgc-ann-color);
    padding: clamp(6px, 0.73vw, 19px) var(--kgc-side);
  }

  .kgc-header__ann-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2px clamp(8px, 1.6vw, 41px);
  }

  .kgc-header__ann-item {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1.6vw, 41px);
  }

  .kgc-header__ann-item + .kgc-header__ann-item::before {
    content: '/';
    font-weight: 700;
    font-size: clamp(0.625rem, 0.88vw, 1.4rem);
    line-height: 1.3;
  }

  .kgc-header__ann-text {
    margin: 0;
    color: var(--kgc-ann-color);
    /* 22px @2560px */
    font-size: clamp(0.625rem, 0.88vw, 1.4rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.1em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  a.kgc-header__ann-text:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---------- Main bar ---------- */
  .kgc-header__main {
    position: relative;
    box-sizing: border-box;
    background-color: var(--kgc-bg);
    color: var(--kgc-color);
    border-bottom: 1px solid var(--kgc-line);
    padding-top: var(--kgc-pad-top);
    padding-bottom: var(--kgc-pad-bottom);
    padding-left: var(--kgc-side);
    padding-right: var(--kgc-side);
  }

  .kgc-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .kgc-header__brand {
    min-width: 0;
  }

  .kgc-header__logo-link {
    display: block;
    width: fit-content;
    color: var(--kgc-color);
    text-decoration: none;
  }

  .kgc-header__logo {
    display: block;
    width: var(--kgc-logo-w);
    max-width: 100%;
    height: auto;
  }

  .kgc-header__logo-text {
    display: block;
    font-family: 'Anton', 'Impact', sans-serif;
    /* 70px @2560px */
    font-size: clamp(1.5rem, 2.734vw, 4.375rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .kgc-header__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- Mobile toggle ---------- */
  .kgc-header__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    margin: 0 -10px 0 auto;
    padding: 0;
    border: 0;
    background: none;
    color: var(--kgc-color);
    cursor: pointer;
  }

  .kgc-header__toggle:focus-visible,
  .kgc-header__link:focus-visible,
  .kgc-header__login:focus-visible,
  .kgc-header__logo-link:focus-visible,
  .kgc-header__ann-text:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .kgc-header__bars {
    position: relative;
    display: block;
    width: 22px;
    height: 14px;
  }

  .kgc-header__bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: currentColor;
    transition: transform 0.25s ease, opacity 0.2s ease, top 0.25s ease;
  }

  .kgc-header__bars span:nth-child(1) { top: 0; }
  .kgc-header__bars span:nth-child(2) { top: 6px; }
  .kgc-header__bars span:nth-child(3) { top: 12px; }

  .kgc-header__toggle[aria-expanded='true'] .kgc-header__bars span:nth-child(1) {
    top: 6px;
    transform: rotate(45deg);
  }
  .kgc-header__toggle[aria-expanded='true'] .kgc-header__bars span:nth-child(2) {
    opacity: 0;
  }
  .kgc-header__toggle[aria-expanded='true'] .kgc-header__bars span:nth-child(3) {
    top: 6px;
    transform: rotate(-45deg);
  }

  /* ---------- Mobile panel ---------- */
  .kgc-header__panel {
    display: none;
    box-sizing: border-box;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding: 8px var(--kgc-side) 24px;
    background-color: var(--kgc-bg);
    border-bottom: 1px solid var(--kgc-line);
  }

  .kgc-header__panel.is-open {
    display: block;
  }

  .kgc-header__menu {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kgc-header__menu-item {
    border-bottom: 1px solid var(--kgc-line);
  }

  .kgc-header__link {
    display: block;
    padding: 16px 0;
    color: var(--kgc-color);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .kgc-header__login {
    display: block;
    padding-top: 20px;
    color: var(--kgc-color);
    opacity: 0.6;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .kgc-header__link[aria-current='page'] {
    color: var(--kgc-color);
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  @media (hover: hover) {
    .kgc-header__link:hover,
    .kgc-header__login:hover {
      opacity: 1;
    }
    .kgc-header__link:hover {
      text-decoration: underline;
      text-underline-offset: 6px;
    }
  }

  /* ---------- Desktop (Dawn breakpoint: 990px) ---------- */
  @media screen and (min-width: 990px) {
    .kgc-header__toggle {
      display: none;
    }

    /* panel becomes part of the row: nav + login */
    .kgc-header__panel {
      display: contents;
    }

    .kgc-header__brand {
      flex: 0 0 29.1%;
      width: 29.1%;
    }

    .kgc-header__nav {
      flex: 1 1 0;
      min-width: 0;
    }

    .kgc-header__menu {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px var(--kgc-nav-gap);
    }

    .kgc-header__menu-item {
      border-bottom: 0;
    }

    .kgc-header__link {
      padding: 0;
      /* 24px @2560px */
      font-size: clamp(0.6875rem, 0.94vw, 1.5rem);
    }

    .kgc-header__login {
      flex: 0 0 auto;
      margin-left: auto;
      margin-right: var(--kgc-side);
      padding: 0;
      white-space: nowrap;
      /* 22px @2560px */
      font-size: clamp(0.625rem, 0.84vw, 1.375rem);
      transition: opacity 0.3s ease;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kgc-header-section,
    .kgc-header__bars span,
    .kgc-header__login {
      transition: none !important;
    }
  }
</style>

<script>
  if (!customElements.get('kgc-header')) {
    class KgcHeader extends HTMLElement {
      connectedCallback() {
        this.wrapper = this.closest('.shopify-section') || this.parentElement;
        this.bar = this.querySelector('.kgc-header__announcement');
        this.main = this.querySelector('.kgc-header__main');
        this.toggle = this.querySelector('.kgc-header__toggle');
        this.panel = this.querySelector('.kgc-header__panel');
        this.desktop = window.matchMedia('(min-width: 990px)');
        this.lastY = window.scrollY;

        this.onToggle = () => this.setMenu(!this.panel.classList.contains('is-open'));
        this.onKey = (e) => {
          if (e.key === 'Escape' && this.panel.classList.contains('is-open')) {
            this.setMenu(false);
            this.toggle.focus();
          }
        };
        this.onDocClick = (e) => {
          if (this.panel.classList.contains('is-open') && !this.contains(e.target)) this.setMenu(false);
        };
        this.onPanelClick = (e) => {
          if (e.target.closest('a')) this.setMenu(false);
        };
        this.onBreakpoint = () => {
          if (this.desktop.matches) this.setMenu(false);
        };
        this.onScroll = () => this.handleScroll();

        this.toggle.addEventListener('click', this.onToggle);
        this.panel.addEventListener('click', this.onPanelClick);
        document.addEventListener('keydown', this.onKey);
        document.addEventListener('click', this.onDocClick);
        this.desktop.addEventListener('change', this.onBreakpoint);

        if (this.dataset.sticky === 'on-scroll-up') {
          window.addEventListener('scroll', this.onScroll, { passive: true });
        }

        this.resizeObserver = new ResizeObserver(() => this.measure());
        this.resizeObserver.observe(this.main);
        if (this.bar) this.resizeObserver.observe(this.bar);
        this.measure();
      }

      disconnectedCallback() {
        document.removeEventListener('keydown', this.onKey);
        document.removeEventListener('click', this.onDocClick);
        window.removeEventListener('scroll', this.onScroll);
        this.desktop.removeEventListener('change', this.onBreakpoint);
        if (this.resizeObserver) this.resizeObserver.disconnect();
        document.documentElement.style.removeProperty('--kgc-header-height');
      }

      setMenu(open) {
        this.panel.classList.toggle('is-open', open);
        this.toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) this.wrapper.classList.remove('kgc-header--hidden');
      }

      measure() {
        const annH = this.bar ? this.bar.offsetHeight : 0;
        const mainH = this.main.offsetHeight;
        const sticky = this.dataset.sticky !== 'none';
        const annScrolls = this.dataset.annScroll === 'true';

        this.wrapper.style.setProperty('--kgc-ann-h', annH + 'px');
        document.documentElement.style.setProperty(
          '--kgc-header-height',
          (sticky ? (annScrolls ? mainH : mainH + annH) : 0) + 'px'
        );
      }

      handleScroll() {
        const y = Math.max(window.scrollY, 0);
        const delta = y - this.lastY;
        const menuOpen = this.panel.classList.contains('is-open');

        if (Math.abs(delta) < 6) return;

        if (delta > 0 && y > this.offsetHeight && !menuOpen) {
          this.wrapper.classList.add('kgc-header--hidden');
        } else if (delta < 0) {
          this.wrapper.classList.remove('kgc-header--hidden');
        }

        this.lastY = y;
      }
    }

    customElements.define('kgc-header', KgcHeader);
  }
</script>

{% schema %}
{
  "name": "KGC Header",
  "tag": "header",
  "class": "kgc-header-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Announcement bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "color",
      "id": "announcement_bg",
      "label": "Announcement background",
      "default": "#ed0019"
    },
    {
      "type": "color",
      "id": "announcement_color",
      "label": "Announcement text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Fallback text (shown if no logo image)",
      "default": "Kris Gethin"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 120,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 450,
      "info": "Size at 2560px screen width. It scales down on smaller screens."
    },
    {
      "type": "header",
      "content": "Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Only top-level links are shown."
    },
    {
      "type": "header",
      "content": "Account link"
    },
    {
      "type": "checkbox",
      "id": "show_login",
      "label": "Show account link",
      "default": true
    },
    {
      "type": "text",
      "id": "login_text",
      "label": "Logged-out text",
      "default": "Member log in"
    },
    {
      "type": "url",
      "id": "login_link",
      "label": "Logged-out link",
      "info": "Leave empty to use the store's default log in page."
    },
    {
      "type": "text",
      "id": "account_text",
      "label": "Logged-in text",
      "default": "My account"
    },
    {
      "type": "header",
      "content": "Sticky header"
    },
    {
      "type": "select",
      "id": "sticky_type",
      "label": "Sticky behavior",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "always", "label": "Always sticky" },
        { "value": "on-scroll-up", "label": "Sticky on scroll up" }
      ],
      "default": "always"
    },
    {
      "type": "checkbox",
      "id": "announcement_scrolls",
      "label": "Announcement bar scrolls away when sticky",
      "default": true,
      "info": "Only the header stays visible. Untick to keep the announcement bar pinned too."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Content color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Header background color",
      "default": "#080808"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Announcement text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KGC Header",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "12-week muscle building challenge"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Home or gym"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Starts 19 October"
          }
        }
      ]
    }
  ]
}
{% endschema %}
