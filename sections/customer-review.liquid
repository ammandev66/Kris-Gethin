                    {%- if block.settings.customer_age != blank or block.settings.weight_loss != blank or block.settings.plan_length != blank -%}
                      <div class="review--info">
                        {%- if block.settings.customer_age != blank -%}
                          <p class="customer-age">Age: {{ block.settings.customer_age }}</p>
                        {%- endif -%}
                        {%- if block.settings.weight_loss != blank -%}
