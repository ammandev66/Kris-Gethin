                        <path d="M49.5656 14.4195L54.6708 17.5008L53.316 11.6934L57.8264 7.78605L51.8869 7.28213L49.5656 1.80518L47.2443 7.28213L41.3047 7.78605L45.8151 11.6934L44.4603 17.5008L49.5656 14.4195Z" fill="#FDD264"/>
                        <path d="M69.3917 14.4195L74.4969 17.5008L73.1422 11.6934L77.6526 7.78605L71.713 7.28213L69.3917 1.80518L67.0704 7.28213L61.1309 7.78605L65.6413 11.6934L64.2865 17.5008L69.3917 14.4195Z" fill="#FDD264"/>
